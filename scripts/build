#!/usr/bin/env python3
"""Build the docs site from the Markdown pages and the samples.

    scripts/build [--out DIR] [--cli PATH] [--app PATH] [--forge-url URL] [--mirror-url URL]

Pages are `index.md`, `samples/index.md` (the Samples page), `tutorials/*.md`
and `manual/*.md`, each section with an `index.md` of its own. A page other than an index is published
when its metadata block carries `Checked:` (the Blockwright build its steps
were checked against); the others are stubs, listed as not written yet and
never linked. The maintainer's pages in `STANDALONE` (`release-checklist.md`)
are built at the site root, always, outside both sections: no list, menu or
pager names them, and each carries a `noindex` robots meta tag.

An image whose source is an `.ans` or a `.bwp` project
(`![alt](../samples/x/y.ans "2x")`) is drawn by `blockwright-cli render` (a
project as its composite) at the scale its title names (1x when it names
none), as `y.ans-2x.png` beside it, and links to the sample, which is copied
beside the picture. Any other image must be a `.png`, copied as it is; an
image of any other kind fails the build.

Any other relative link names a file in the repo (a `.bwp` or an `.ans` no
page draws), which is copied into the site at the same path.

`<!-- generated: cli-help -->` at the start of a line of its own (in column 0:
not indented, not in a list item or blockquote), outside code, becomes the
output of `blockwright-cli --help`. `<!-- generated: checklist -->` becomes a
table per section of every tutorial and manual page: its
status in `PLAN.md` (the leading words of the Status cell of the row in a table
with a Tutorial or Page column whose name, made a slug, is the page's file name
without its number), the commit its `Checked:` names, and whether that is the
CLI's commit (ready), another one (behind) or none (not written). `<!-- generated: shortcuts -->` becomes
a table per menu of every action `blockwright --list-actions` lists: its name,
its default keys and what it does. The app's `--version` must name the same
Blockwright commit as the CLI's, and the app may take $BW_DOCS_APP_TIMEOUT
seconds (default 120) to answer. `<!-- list: tutorials -->`
and `<!-- list: manual -->` become the list of that section's pages. A marker
is written exactly so: lowercase, one space after `<!--`, after the colon and
before `-->`. Markers are replaced inside Python-Markdown, after it has set
fenced code aside, so a marker is code exactly when Markdown shows it as code.
A marker comment still in a page's HTML fails the build: one in the wrong place
with a message naming the column-0 rule, a misspelled one (any `<!-- generated:`
or `<!-- list:` comment, in any case, that isn't one of the five) with a
message naming the five.

Every page carries the site menu (`theme/page.html`'s `$nav`): the home link,
then each section's index and its pages in the order the index lists them,
stubs dimmed and unlinked; the page itself is marked `aria-current="page"` and
its section `here`. A standalone page carries the menu too, with nothing in it
marked.

The site also gets `robots.txt`, which lets crawlers fetch everything, and,
when `ROBOTS` is set, a robots meta tag on every page but the standalone ones,
which always carry `noindex`.

Pages link to the forge as `https://git.pumpin.online/...` (FORGE). `--forge-url
URL` puts URL in its place in every link of the built site, so a copy of the
site can send downloads to another address of the forge. `--mirror-url URL`
adds a line to every page's footer naming the site's other address. A page,
template included, may link out of the site only to the forge, the mirror and
the licence (ALLOWED_EXTERNAL): any other http, https or // address in a tag's
href, src, srcset, poster, data, action, formaction, cite, background or style
url() fails the build, so the site works where only those addresses can be
reached. Text in code, in <pre> and in comments is no link.

The build fails on a link or image that doesn't resolve, a `#fragment` the
target page has no id for, a link to a stub, a path that leaves the repo or
resolves into `.git/` or `site/`, a missing sample, a sample the CLI can't
render, or an image that is neither a sample nor a `.png`.

The output directory is cleared only when it is empty or is a site this script
built: it writes `.blockwright-docs-manifest` (every file it wrote) into the
site, and refuses a directory without one, or with a file the manifest doesn't
list. It refuses
any output inside the repo other than `site/`, and any that contains the repo.
"""

import argparse
import html
import json
import os
import re
import shutil
import struct
import subprocess
import sys
from pathlib import Path
from string import Template
from urllib.parse import unquote

try:
    import markdown
    from markdown.preprocessors import Preprocessor
except ImportError:
    sys.exit("build: needs Python-Markdown (python-markdown on Arch, python3-markdown on Debian)")

ROOT = Path(__file__).resolve().parent.parent
SECTIONS = {"tutorials": "Tutorials", "manual": "Manual"}
# Pages of their own, each a folder's index.md: listed in the menu after the
# home link, before the sections.
TOP_PAGES = {"samples": "Samples"}
# The maintainer's pages at the site root: built always, linked from no list,
# menu or pager, and kept out of search engines (PLAN.md §6).
STANDALONE = ("release-checklist.md",)
SITE_NAME = "Blockwright"
SCALE_RE = re.compile(r"^([1-8])x$")
# Images drawn by blockwright-cli render, and images copied as they are.
SAMPLE_TYPES = (".ans", ".bwp")
IMAGE_TYPES = (".png",)
# The robots meta tag every page carries; "" for none. The site has its own
# domain and is meant to be indexed (PLAN.md §7).
ROBOTS = ""
# Written into the site as robots.txt: crawlers may fetch everything.
ROBOTS_TXT = "User-agent: *\nAllow: /\n"
# Written into the site; names every file the build wrote.
MANIFEST = ".blockwright-docs-manifest"
# The forge as pages write it; --forge-url puts another address in its place.
FORGE = "https://git.pumpin.online"
# The only links out of the site besides the forge and the mirror.
ALLOWED_EXTERNAL = ("https://creativecommons.org/licenses/by-sa/4.0/",)
# An address --forge-url and --mirror-url take: http or https, a host, an
# optional port and path, nothing else.
URL_RE = re.compile(r"^https?://[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?(?::\d{1,5})?(?:/[A-Za-z0-9._~!$&'()*+,;=:@%/-]*)?$")
ABSOLUTE_RE = re.compile(r"^(?:https?:)?//", re.I)
# A comment, or an HTML tag with its attributes; an href or src attribute in one.
TAG_RE = re.compile(r"<!--.*?-->|<[A-Za-z][^<>]*>", re.S)
ATTR_RE = re.compile(r"""(?<![\w-])(href|src|srcset|poster|data|action|formaction|cite|background|style)\s*=\s*"""
                     r"""(?:(["'])(.*?)\2|([^\s"'=<>`]+))""", re.I | re.S)
# A url(...) in a style attribute.
CSS_URL_RE = re.compile(r"""url\(\s*(["']?)(.*?)\1\s*\)""", re.I | re.S)
EXTERNAL_RE = re.compile(r"^[a-z][a-z0-9+.-]*:|^//", re.I)
MARKER_RE = re.compile(r"^<!-- (generated|list): ([a-z-]+) -->[ \t]*$")
# The markers a page may use, exactly as written.
MARKERS = ("<!-- generated: cli-help -->", "<!-- generated: shortcuts -->", "<!-- generated: checklist -->",
           "<!-- list: tutorials -->", "<!-- list: manual -->")
# The commit in a version or a Checked: line: "Blockwright 0.1.0 (30c37b9)".
COMMIT_RE = re.compile(r"\(([^()\s]+)\)\s*$")
# How long the app may take to answer --version or --list-actions before the
# build gives up, in seconds; $BW_DOCS_APP_TIMEOUT sets another.
APP_TIMEOUT = 120
# A marker, or something meant as one, left in a page's HTML: the comment up to
# its close when it has one.
LEFT_MARKER_RE = re.compile(r"<!--\s*(?:generated|list)\s*:(?:[^>]*-->)?", re.I)
# Python-Markdown's fenced_code_block preprocessor runs at 25 and html_block at
# 20; markers are replaced between the two.
MARKER_PRIORITY = 22


class BuildError(Exception):
    pass


def find_cli(explicit):
    # One that was asked for is used or refused, never passed over.
    for asked, how in [(explicit, "--cli"), (os.environ.get("BLOCKWRIGHT_CLI"), "BLOCKWRIGHT_CLI")]:
        if asked:
            found = shutil.which(asked)
            if not found:
                raise BuildError(f"{how}: {asked} isn't an executable")
            return found
    for name in ["blockwright-cli-dev", "blockwright-cli"]:
        if shutil.which(name):
            return shutil.which(name)
    raise BuildError("no blockwright-cli: pass --cli or set BLOCKWRIGHT_CLI")


def find_app(explicit, cli):
    """The Blockwright app (the window's binary) that <!-- generated: shortcuts -->
    runs, or None when there is none. One asked for is used or refused, as for
    --cli; else the app installed beside the CLI (blockwright-dev beside
    blockwright-cli-dev, blockwright beside blockwright-cli), else
    blockwright-dev or blockwright on PATH."""
    for asked, how in [(explicit, "--app"), (os.environ.get("BLOCKWRIGHT_APP"), "BLOCKWRIGHT_APP")]:
        if asked:
            found = shutil.which(asked)
            if not found:
                raise BuildError(f"{how}: {asked} isn't an executable")
            return found
    cli = Path(cli)
    if "blockwright-cli" in cli.name:
        beside = shutil.which(str(cli.with_name(cli.name.replace("blockwright-cli", "blockwright", 1))))
        if beside:
            return beside
    for name in ["blockwright-dev", "blockwright"]:
        if shutil.which(name):
            return shutil.which(name)
    return None


def run(cmd):
    r = subprocess.run(cmd, capture_output=True, text=True)
    if r.returncode != 0:
        raise BuildError(f"{' '.join(map(str, cmd))} exited {r.returncode}: {r.stderr.strip()}")
    return r.stdout


def png_size(path):
    try:
        with open(path, "rb") as f:
            head = f.read(24)
    except OSError as e:
        raise BuildError(f"{path}: the render wrote no picture ({e.strerror})")
    if head[:8] != b"\x89PNG\r\n\x1a\n":
        raise BuildError(f"{path} is not a PNG")
    return struct.unpack(">II", head[16:24])


def in_repo(rel):
    """rel (a path from ROOT) as a normalised Path, or None if it leaves the repo."""
    path = Path(os.path.normpath(rel))
    if path.is_absolute() or path.parts[:1] == ("..",):
        return None
    if not (ROOT / path).resolve().is_relative_to(ROOT):
        return None  # a symlink out of the repo
    return path


def refused(target):
    """Why the site can't carry target (a path from in_repo), or None. Checked on
    the resolved path, so a symlink into .git/ or site/ is refused too."""
    real = (ROOT / target).resolve().relative_to(ROOT)
    if not real.parts or real.parts[0] in (".git", "site"):
        return "not a file the site can carry"
    return None


def unknown_marker(page, found):
    return (f"{page.rel}: {found} is not a marker the build knows; the markers are "
            f"{', '.join(MARKERS)}, written exactly so (lowercase, single spaces as shown)")


class Markers(Preprocessor):
    """Replaces each marker line Markdown hasn't set aside as code with the HTML
    replace(kind, name) returns, stashed so Markdown passes it through as is."""

    def __init__(self, md, replace):
        super().__init__(md)
        self.replace = replace

    def run(self, lines):
        out = []
        for line in lines:
            m = MARKER_RE.match(line)
            if m:
                out += ["", self.md.htmlStash.store(self.replace(m.group(1), m.group(2))), ""]
            else:
                out.append(line)
        return out


def site_files(out):
    """Every file and symlink under out, as paths relative to it."""
    found = set()
    for d, dirs, files in os.walk(out):
        for name in files + [x for x in dirs if os.path.islink(os.path.join(d, x))]:
            found.add(os.path.relpath(os.path.join(d, name), out))
    return found


def prepare_out(out):
    """Make out an empty directory, clearing it only if it is a site this script built."""
    if out == ROOT / "site":
        pass
    elif out.is_relative_to(ROOT):
        raise BuildError(f"--out {out}: inside the repo; only site/ may be built there")
    elif ROOT.is_relative_to(out):
        raise BuildError(f"--out {out}: holds the repo; not clearing it")
    if out.exists() or out.is_symlink():
        if not out.is_dir():
            raise BuildError(f"--out {out}: not a directory")
        if any(out.iterdir()):
            manifest = out / MANIFEST
            if not manifest.is_file():
                raise BuildError(f"--out {out}: not empty and not a site this build wrote (no {MANIFEST}); "
                                 "not clearing it")
            listed = set(manifest.read_text(encoding="utf-8").splitlines()) | {MANIFEST}
            extra = sorted(site_files(out) - listed)
            if extra:
                raise BuildError(f"--out {out}: holds files the build didn't write ({', '.join(extra[:5])}"
                                 f"{', …' if len(extra) > 5 else ''}); not clearing it")
            shutil.rmtree(out)
    out.mkdir(parents=True, exist_ok=True)
    # Claim the directory before writing anything else into it.
    (out / MANIFEST).write_text("", encoding="utf-8")


def write_manifest(out):
    files = sorted(site_files(out) - {MANIFEST})
    (out / MANIFEST).write_text("".join(f + "\n" for f in files), encoding="utf-8")


class Page:
    def __init__(self, src):
        self.src = src
        self.rel = src.relative_to(ROOT)
        self.section = self.rel.parts[0] if len(self.rel.parts) > 1 else ""
        self.out = self.rel.with_suffix(".html")
        md = markdown.Markdown(extensions=["meta"])
        md.convert(src.read_text(encoding="utf-8"))
        meta = {k: " ".join(v) for k, v in md.Meta.items()}
        self.checked = meta.get("checked", "")
        self.title = meta.get("title", "")
        if not self.title:
            m = re.search(r"^# (.+)$", src.read_text(encoding="utf-8"), re.M)
            self.title = m.group(1).strip() if m else src.stem
        self.is_index = src.name == "index.md"
        self.standalone = not self.section and not self.is_index
        self.published = bool(self.checked) or self.is_index or self.standalone


def collect_pages():
    pages = [Page(ROOT / "index.md")]
    for folder in TOP_PAGES:
        pages.append(Page(ROOT / folder / "index.md"))
    for section in SECTIONS:
        pages.append(Page(ROOT / section / "index.md"))
        for src in sorted((ROOT / section).glob("*.md")):
            if src.name != "index.md":
                pages.append(Page(src))
    for name in STANDALONE:
        if (ROOT / name).is_file():
            pages.append(Page(ROOT / name))
    return pages


def section_pages(pages, section):
    """The section's pages other than its index, in the order every list of
    them (the index lists, the menu, the pager) shows them."""
    return [p for p in pages if p.section == section and not p.is_index]


def section_list(pages, section, here):
    items = []
    for p in section_pages(pages, section):
        if p.published:
            href = os.path.relpath(p.out, here.out.parent)
            items.append(f'<li><a href="{html.escape(href)}">{html.escape(p.title)}</a></li>')
        else:
            items.append(f'<li class="soon">{html.escape(p.title)} <span>(not written yet)</span></li>')
    return "<ol>\n" + "\n".join(items) + "\n</ol>"


def cli_help(cli):
    out = run([cli, "--help"])
    start = out.find("Usage:")
    if start < 0:
        raise BuildError("blockwright-cli --help printed no Usage line")
    out = out[start:]
    # The usage line names the binary it was run as (blockwright-cli-dev).
    out = re.sub(r"^Usage: \S+", "Usage: blockwright-cli", out, count=1)
    return "<pre class=\"help\">" + html.escape(out.rstrip()) + "</pre>"


def app_timeout():
    """APP_TIMEOUT, or the seconds $BW_DOCS_APP_TIMEOUT names."""
    asked = os.environ.get("BW_DOCS_APP_TIMEOUT")
    if asked is None:
        return APP_TIMEOUT
    try:
        seconds = float(asked)
    except ValueError:
        seconds = 0
    if not 0 < seconds < float("inf"):
        raise BuildError(f"BW_DOCS_APP_TIMEOUT: {asked!r} isn't a number of seconds above 0")
    return seconds


def run_app(app, timeout, *args):
    """The app's stdout for args, run with no display. The app sets
    QT_QPA_PLATFORM=offscreen itself for --list-actions; setting it here too
    does no harm."""
    env = dict(os.environ, QT_QPA_PLATFORM="offscreen")
    try:
        r = subprocess.run([app, *args], capture_output=True, text=True, encoding="utf-8", errors="replace", env=env,
                           stdin=subprocess.DEVNULL, timeout=timeout)
    except subprocess.TimeoutExpired:
        raise BuildError(f"{app} {' '.join(args)} didn't finish in {timeout:g} s")
    except OSError as e:
        raise BuildError(f"{app} {' '.join(args)} couldn't run: {e.strerror}")
    if r.returncode != 0:
        raise BuildError(f"{app} {' '.join(args)} exited {r.returncode}: {r.stderr.strip()}")
    return r.stdout


KEY_RE = re.compile(r"^((?:(?:Ctrl|Shift|Alt|Meta)\+)*)(.+)$")


def kbd(key):
    """A key in portable text (Ctrl+Shift+B, Ctrl++) as <kbd>Ctrl</kbd>+<kbd>Shift</kbd>+<kbd>B</kbd>."""
    mods, last = KEY_RE.match(key).groups()
    return "+".join(f"<kbd>{html.escape(k)}</kbd>" for k in mods.split("+")[:-1] + [last])


def does(action):
    """What an action does, as the app says it: its status tip, else its tooltip
    when that says more than its name."""
    text = action["statusTip"].strip()
    if not text:
        lines = action["toolTip"].strip().splitlines()
        # Qt's own tooltip is the menu text, keys after a tab ("Delete\tDel");
        # a tool's starts with its name and key: "Keyboard (Ctrl+K)"
        if lines:
            lines[0] = lines[0].split("\t")[0].strip()
        if lines and (lines[0] == action["text"] or re.fullmatch(re.escape(action["text"]) + r" \(.*\)", lines[0])):
            lines = lines[1:]
        text = " ".join(line.strip() for line in lines if line.strip())
    if action.get("offeredWhen"):
        text = (text + " " if text else "") + f"Offered only {action['offeredWhen']}."
    return text


def shortcuts(app, cli_version, timeout):
    """The tables <!-- generated: shortcuts --> becomes (every action
    `blockwright --list-actions` lists, a table per menu in its order, each
    action's name, default keys and what it does), and the app's version and Qt.
    The app must be from the same Blockwright commit as the CLI (cli_version,
    the first line of its --version)."""
    if not app:
        raise BuildError("<!-- generated: shortcuts --> needs the Blockwright app: none beside the CLI and no "
                         "blockwright-dev or blockwright on PATH; pass --app or set BLOCKWRIGHT_APP")
    version = run_app(app, timeout, "--version").splitlines()
    m = re.fullmatch(r"Qt (\d[\d.]*)", version[1].strip()) if len(version) > 1 else None
    if not version or not m:
        raise BuildError(f"{app} --version names no Qt on its second line; the shortcuts page needs a "
                         "Blockwright whose --version does (#463)")
    name = re.sub(r"^\S+", "Blockwright", version[0].strip(), count=1)
    # "blockwright 0.1.0 (ad55097)" and "blockwright-cli 0.1.0 (ad55097)": the
    # same once the program's name is dropped.
    if version[0].split()[1:] != cli_version.split()[1:]:
        raise BuildError(f"{app} is {version[0].strip()} but the CLI is {cli_version.strip()}; the shortcuts page "
                         "needs the app from the same Blockwright commit as the CLI")
    out = run_app(app, timeout, "--list-actions")
    try:
        actions = json.loads(out)
        groups = {}
        for a in actions:
            groups.setdefault(a["menu"], []).append(a)
            a["text"], a["shortcuts"], a["statusTip"], a["toolTip"]
    except (ValueError, TypeError, KeyError) as e:
        raise BuildError(f"{app} --list-actions printed no action list ({e}): {out.strip()[:200]}")
    if not actions:
        raise BuildError(f"{app} --list-actions listed no actions")
    parts = [f"<p>These are the keys {html.escape(name)} starts with on Qt {m.group(1)}.</p>"]
    if any(a.get("standardKey") for a in actions):
        parts.append("<p>Keys marked <em>(standard)</em> are the platform's standard keys for that action: the "
                     "table gives the ones Qt gives a Linux desktop, and another platform, or another version "
                     "of Qt, can give the action other keys.</p>")
        # Qt gives some standard actions a key of its own (Undo, F14) that
        # some keyboards have; a key with a modifier is made of ordinary keys.
        own = dict.fromkeys(k for a in actions if a.get("standardKey") for k in a["shortcuts"]
                            if not KEY_RE.match(k).group(1))
        if own:
            keys = [kbd(k) for k in own]
            listed = keys[0] if len(keys) == 1 else ", ".join(keys[:-1]) + " and " + keys[-1]
            parts.append(f"<p>{listed} {'is a key' if len(keys) == 1 else 'are keys'} some keyboards have.</p>")
    ids = set()
    for menu, rows in groups.items():
        slug = "keys-" + (re.sub(r"[^a-z0-9]+", "-", menu.lower()).strip("-") or "other")
        n, base = 2, slug
        while slug in ids:
            slug, n = f"{base}-{n}", n + 1
        ids.add(slug)
        parts.append(f'<h3 id="{slug}">{html.escape(menu)}</h3>')
        parts.append('<table class="keys">\n<thead><tr><th>Action</th><th>Shortcut</th><th>What it does</th></tr>'
                     "</thead>\n<tbody>")
        for a in rows:
            keys = list(a["shortcuts"]) + [k for k in a.get("hint", "").split(", ") if k]
            cell = ", ".join(kbd(k) for k in keys)
            if keys and a.get("standardKey"):
                cell += " <em>(standard)</em>"
            parts.append(f"<tr><td>{html.escape(a['text'])}</td><td>{cell}</td>"
                         f"<td>{html.escape(does(a))}</td></tr>")
        parts.append("</tbody>\n</table>")
    return "\n".join(parts), f"{name}, Qt {m.group(1)}"


def slug(text):
    return re.sub(r"[^a-z0-9]+", "-", text.lower()).strip("-")


def plan_statuses():
    """{(section, slug): status} from PLAN.md: every table with a Status column
    and a Tutorial (tutorials) or Page (manual) column, the status cut to its
    leading words (before the first comma, colon, semicolon or bracket)."""
    try:
        text = (ROOT / "PLAN.md").read_text(encoding="utf-8")
    except OSError as e:
        raise BuildError(f"<!-- generated: checklist --> needs PLAN.md: {e.strerror}")
    found = {}
    header = None
    for line in text.splitlines():
        if not line.startswith("|"):
            header = None
            continue
        cells = [c.strip() for c in re.split(r"(?<!\\)\|", line.strip())[1:-1]]
        if header is None:
            header = cells
            continue
        if all(re.fullmatch(r":?-+:?", c) for c in cells):
            continue
        row = dict(zip(header, cells))
        for column, section in (("Tutorial", "tutorials"), ("Page", "manual")):
            if column in row and "Status" in row:
                found[(section, slug(row[column]))] = re.split(r"[,:;(]", row["Status"], maxsplit=1)[0].strip()
    return found


def inline_code(text):
    """text escaped, with `code` spans as <code>."""
    return re.sub(r"`([^`]+)`", r"<code>\1</code>", html.escape(text, quote=False))


def same_commit(a, b):
    """Whether a and b name one commit: the same hex, or one a prefix of the other
    at 7 digits or more. A build from a changed tree ("7e06a97-dirty") is no
    commit, so no page was checked against it."""
    if not (re.fullmatch(r"[0-9a-f]+", a) and re.fullmatch(r"[0-9a-f]+", b)):
        return False
    return a == b or (min(len(a), len(b)) >= 7 and (a.startswith(b) or b.startswith(a)))


def checklist(pages, here, cli_version):
    """The tables <!-- generated: checklist --> becomes on here: every tutorial
    and manual page, with its PLAN.md status, the commit its Checked:
    names and whether that is the CLI's (cli_version, the first line of its
    --version)."""
    m = COMMIT_RE.search(cli_version.strip())
    if not m:
        raise BuildError(f"<!-- generated: checklist -->: the CLI's version names no commit: {cli_version.strip()}")
    commit = m.group(1)
    name = re.sub(r"^\S+", "Blockwright", cli_version.strip(), count=1)
    statuses = plan_statuses()
    counts = {"ready": 0, "behind": 0, "not written": 0}
    tables = []
    for section, title in SECTIONS.items():
        rows = []
        for p in section_pages(pages, section):
            status = statuses.get((section, slug(re.sub(r"^\d+-", "", p.src.stem))), "")
            if p.published:
                href = os.path.relpath(p.out, here.out.parent)
                cell = f'<a href="{html.escape(href)}">{html.escape(p.title)}</a>'
                cm = COMMIT_RE.search(p.checked)
                checked = f"<code>{html.escape(cm.group(1))}</code>" if cm else html.escape(p.checked)
                ready = "ready" if cm and same_commit(cm.group(1), commit) else "behind"
            else:
                cell, checked, ready = html.escape(p.title), "", "not written"
            counts[ready] += 1
            rows.append(f"<tr><td>{cell}</td><td>{inline_code(status)}</td><td>{checked}</td><td>{ready}</td></tr>")
        tables.append(f'<h3 id="checklist-{section}">{title}</h3>\n<table class="checklist">\n<thead><tr><th>Page</th>'
                      "<th>Status</th><th>Checked against</th><th>Ready</th></tr></thead>\n<tbody>\n"
                      + "\n".join(rows) + "\n</tbody>\n</table>")
    total = sum(counts.values())
    summary = (f"<p>{html.escape(name)}: {counts['ready']} of {total} pages ready, {counts['behind']} behind, "
               f"{counts['not written']} not written.</p>\n"
               f"<p>A page is ready when it is written and was last checked against <code>{html.escape(commit)}</code>. "
               "A page checked against another commit is behind: its steps and options have to be checked again "
               "against this one.</p>")
    return summary + "\n" + "\n".join(tables)


def within(url, base):
    """Whether url is base or under it: base itself, or base followed by a /, a
    ? or a #, so https://git.pumpin.online.example.test isn't the forge."""
    base = base.rstrip("/")
    return url == base or url.startswith((base + "/", base + "?", base + "#"))


def site_url(how, url):
    """url, which --forge-url or --mirror-url gave, if it is an http or https
    address with a host (and only a port and path after it)."""
    port = re.match(r"^https?://[^/:]+:(\d+)", url)
    if not URL_RE.match(url) or (port and not 0 < int(port.group(1)) < 65536):
        raise BuildError(f"{how}: {url!r} isn't an http:// or https:// address with a host (and an optional port "
                         "and path, no query or fragment)")
    return url


class Builder:
    def __init__(self, out, cli, app=None, forge=FORGE, mirror=None):
        self.out = out
        self.cli = cli
        self.app = app
        self.forge = forge.rstrip("/")
        self.mirror = mirror
        self.app_used = None
        self.rendered = {}
        self.errors = []
        self.pages = collect_pages()
        self.by_out = {p.out: p for p in self.pages}
        self.template = Template((ROOT / "theme" / "page.html").read_text(encoding="utf-8"))
        self.version = run([cli, "--version"]).splitlines()[0].replace("blockwright-cli-dev", "blockwright-cli")
        self.app_timeout = app_timeout()

    def render_sample(self, ans, scale):
        """Draw ans (a path from ROOT to an .ans or .bwp) at scale; returns the
        PNG's site path and size. The PNG keeps the sample's whole name
        (final.ans-2x.png), so final.ans and final.bwp in one folder each get
        their own."""
        key = (ans, scale)
        if key in self.rendered:
            return self.rendered[key]
        src = ROOT / ans
        if not src.is_file():
            raise BuildError(f"no sample {ans}")
        png = ans.with_name(f"{ans.name}-{scale}x.png")
        dest = self.out / png
        dest.parent.mkdir(parents=True, exist_ok=True)
        run([self.cli, "render", "--scale", str(scale), str(src), str(dest)])
        shutil.copyfile(src, self.out / ans)
        self.rendered[key] = (png, png_size(dest))
        return self.rendered[key]

    def fix_images(self, page, body):
        def img(m):
            attrs = m.group(1)
            src = html.unescape(re.search(r'src="([^"]+)"', attrs).group(1))
            if EXTERNAL_RE.match(src):
                return m.group(0)
            kind = os.path.splitext(unquote(src.partition("#")[0]))[1]
            if kind in IMAGE_TYPES:
                self.copy_asset(page, src)
                return m.group(0)
            if kind not in SAMPLE_TYPES:
                raise BuildError(f"{page.rel}: {src}: not a picture the build can show; an image is a sample "
                                 f"({', '.join(SAMPLE_TYPES)}, drawn by blockwright-cli render) or "
                                 f"{', '.join(IMAGE_TYPES)}")
            title = re.search(r'title="([^"]*)"', attrs)
            scale = 1
            if title:
                sm = SCALE_RE.match(title.group(1))
                if not sm:
                    raise BuildError(f"{page.rel}: {src}: the title names a scale, 1x to 8x, not {title.group(1)!r}")
                scale = int(sm.group(1))
            ans = in_repo(page.rel.parent / unquote(src))
            if ans is None:
                raise BuildError(f"{page.rel}: {src}: outside the repo")
            why = refused(ans)
            if why:
                raise BuildError(f"{page.rel}: {src}: {why}")
            png, (w, h) = self.render_sample(ans, scale)
            alt = re.search(r'alt="([^"]*)"', attrs)
            alt = alt.group(1) if alt else ""
            href = os.path.relpath(ans, page.out.parent)
            pngref = os.path.relpath(png, page.out.parent)
            return (f'<a class="ans" href="{html.escape(href)}"><img src="{html.escape(pngref)}" '
                    f'alt="{alt}" width="{w}" height="{h}"></a>')

        return re.sub(r"<img ([^>]*)/?>", img, body)

    def copy_asset(self, page, ref):
        """Copy the repo file a relative link or image names into the site."""
        path = unquote(ref.partition("#")[0])
        if not path:
            return
        target = in_repo(page.rel.parent / path)
        if target is None:
            self.errors.append(f"{page.rel}: {ref}: outside the repo")
        elif refused(target):
            self.errors.append(f"{page.rel}: {ref}: {refused(target)}")
        elif not (ROOT / target).is_file():
            self.errors.append(f"{page.rel}: {ref}: no such file")
        elif (self.out / target).exists():
            return  # a page, a rendered sample or an asset already copied
        else:
            (self.out / target).parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(ROOT / target, self.out / target)

    def fix_links(self, page, body):
        def link(m):
            href = html.unescape(m.group(1))
            if EXTERNAL_RE.match(href) or href.startswith("#"):
                return m.group(0)
            path, _, frag = href.partition("#")
            if path.endswith((".md", ".html")):
                target = in_repo(page.rel.parent / unquote(path))
                tp = self.by_out.get(target.with_suffix(".html")) if target else None
                if tp is None:
                    self.errors.append(f"{page.rel}: link to {href}: no such page")
                elif not tp.published:
                    self.errors.append(f"{page.rel}: link to {href}: that page isn't written yet")
                if path.endswith(".md"):
                    path = path[:-3] + ".html"
            else:
                self.copy_asset(page, href)
            return 'href="' + html.escape(path + ("#" + frag if frag else "")) + '"'

        return re.sub(r'href="([^"]+)"', link, body)

    def fix_external(self, page, doc):
        """Puts the forge's address (--forge-url) in place of FORGE in every
        address a tag of the page names (the template's included), and fails one
        out of the site that isn't the forge, the mirror or the licence."""
        def moved(url):
            """url with the forge's address moved, and whether it was."""
            url = url.strip()
            if within(url, FORGE):
                return self.forge + url[len(FORGE):], True
            return url, False

        def check(url):
            if ABSOLUTE_RE.match(url):
                ok = within(url, self.forge) or url in ALLOWED_EXTERNAL or bool(self.mirror and within(url, self.mirror))
                if not ok:
                    self.errors.append(f"{page.rel}: {url}: a link out of the site; pages link only to the forge "
                                       f"({self.forge}), the mirror and the licence")

        def attr(m):
            name, quote = m.group(1).lower(), m.group(2) or '"'
            raw = m.group(3) if m.group(2) else m.group(4)
            value = html.unescape(raw)
            if name == "style":
                def css(u):
                    url, _ = moved(u.group(2))
                    check(url)
                    return f"url({u.group(1)}{url}{u.group(1)})"
                new = CSS_URL_RE.sub(css, value)
            elif name == "srcset":
                parts = []
                for candidate in filter(str.split, value.split(",")):
                    url, *rest = candidate.split()
                    url, _ = moved(url)
                    check(url)
                    parts.append(" ".join([url, *rest]))
                new = ", ".join(parts)
            else:
                new, _ = moved(value)
                check(new)
            if new == value:
                return m.group(0)
            return f"{m.group(1)}={quote}{html.escape(new)}{quote}"

        def tag(m):
            if m.group(0).startswith("<!--"):
                return m.group(0)  # a comment: nothing in it is a link
            return ATTR_RE.sub(attr, m.group(0))

        # Only attributes of real tags: code and <pre> text has its < escaped,
        # and a comment links to nothing.
        return TAG_RE.sub(tag, doc)

    def neighbours(self, page):
        if not page.section or page.is_index:
            return ""
        same = [p for p in section_pages(self.pages, page.section) if p.published]
        i = same.index(page)
        parts = []
        if i > 0:
            parts.append(f'<a rel="prev" href="{same[i-1].out.name}">← {html.escape(same[i-1].title)}</a>')
        if i + 1 < len(same):
            parts.append(f'<a rel="next" href="{same[i+1].out.name}">{html.escape(same[i+1].title)} →</a>')
        return '<nav class="pager">' + " ".join(parts) + "</nav>" if parts else ""

    def menu(self, page):
        """The site menu every page carries: the home link, then each section's
        index and its pages in order, stubs dimmed and unlinked as in the index
        lists. The page itself is marked aria-current, its section "here"."""
        def link(p, text, cls=""):
            href = os.path.relpath(p.out, page.out.parent)
            attrs = f' class="{cls}"' if cls else ""
            if p is page:
                attrs += ' aria-current="page"'
            return f'<a{attrs} href="{html.escape(href)}">{html.escape(text)}</a>'

        home = next(p for p in self.pages if not p.section and p.is_index)
        parts = []
        for folder, name in TOP_PAGES.items():
            top = next(p for p in self.pages if p.section == folder and p.is_index)
            parts.append(f'<div class="top">{link(top, name)}</div>')
        for section, name in SECTIONS.items():
            index = next(p for p in self.pages if p.section == section and p.is_index)
            items = []
            for p in section_pages(self.pages, section):
                if p.published:
                    items.append(f"<li>{link(p, p.title)}</li>")
                else:
                    items.append(f'<li class="soon" title="Not written yet">{html.escape(p.title)}</li>')
            here = " here" if page.section == section else ""
            parts.append(f'<div class="part{here}">\n{link(index, name, "part-name")}\n<ol>\n'
                         + "\n".join(items) + "\n</ol>\n</div>")
        return ('<nav class="side" aria-label="Site">\n' + link(home, SITE_NAME.upper(), "home") + "\n"
                '<details class="menu">\n<summary>Menu</summary>\n<div class="parts">\n'
                + "\n".join(parts) + "\n</div>\n</details>\n</nav>")

    def build_page(self, page):
        text = page.src.read_text(encoding="utf-8")

        def replace(kind, name):
            if kind == "generated":
                if name == "cli-help":
                    return cli_help(self.cli)
                if name == "shortcuts":
                    table, self.app_used = shortcuts(self.app, self.version, self.app_timeout)
                    return table
                if name == "checklist":
                    return checklist(self.pages, page, self.version)
                raise BuildError(unknown_marker(page, f"<!-- generated: {name} -->"))
            if name not in SECTIONS:
                raise BuildError(unknown_marker(page, f"<!-- list: {name} -->"))
            return section_list(self.pages, name, page)

        md = markdown.Markdown(extensions=["meta", "extra", "toc", "sane_lists"],
                               extension_configs={"toc": {"permalink": False}})
        md.preprocessors.register(Markers(md, replace), "blockwright_markers", MARKER_PRIORITY)
        body = md.convert(text)
        left = LEFT_MARKER_RE.search(body)
        if left and left.group(0) not in MARKERS:
            raise BuildError(unknown_marker(page, left.group(0)))
        if left:
            raise BuildError(f"{page.rel}: a <!-- generated: --> or <!-- list: --> marker was left as a "
                             "comment; put it at the start of a line of its own (not indented, not in a list "
                             "item or blockquote), outside code")
        body = self.fix_images(page, body)
        body = self.fix_links(page, body)
        up = os.path.relpath(".", page.out.parent)
        root = "" if up == "." else up + "/"
        checked = ""
        if page.checked:
            checked = f'<p class="checked">Describes {html.escape(page.checked)}.</p>'
        title = SITE_NAME if not page.section and page.is_index else f"{page.title} · {SITE_NAME}"
        robots = "noindex" if page.standalone else ROBOTS
        robots = f'<meta name="robots" content="{html.escape(robots)}">\n' if robots else ""
        mirror = ""
        if self.mirror:
            mirror = f'<br>\nAlso at <a href="{html.escape(self.mirror)}">{html.escape(self.mirror)}</a>'
        doc = self.template.substitute(
            title=html.escape(title),
            robots=robots,
            root=root,
            body=body,
            checked=checked,
            pager=self.neighbours(page),
            nav=self.menu(page),
            mirror=mirror,
        )
        doc = self.fix_external(page, doc)
        dest = self.out / page.out
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_text(doc, encoding="utf-8")

    def check_refs(self):
        """Every relative href and src in the built site resolves to a file in
        it, and every #fragment to an id on the page it names."""
        ids = {}

        def ids_of(f):
            if f not in ids:
                text = f.read_text(encoding="utf-8")
                ids[f] = {html.unescape(i) for i in re.findall(r'\bid="([^"]*)"', text)}
            return ids[f]

        out = self.out.resolve()
        for f in sorted(out.rglob("*.html")):
            text = f.read_text(encoding="utf-8")
            for ref in re.findall(r'(?:href|src)="([^"]+)"', text):
                ref = html.unescape(ref)
                if EXTERNAL_RE.match(ref):
                    continue
                path, _, frag = ref.partition("#")
                target = (f.parent / unquote(path)).resolve() if path else f
                if not target.is_relative_to(out) or not target.is_file():
                    self.errors.append(f"{f.relative_to(out)}: {ref} doesn't resolve")
                elif frag and target.suffix == ".html" and unquote(frag) not in ids_of(target):
                    self.errors.append(f"{f.relative_to(out)}: {ref}: no #{frag} on that page")

    def build(self):
        prepare_out(self.out)
        try:
            shutil.copyfile(ROOT / "theme" / "site.css", self.out / "site.css")
            (self.out / "robots.txt").write_text(ROBOTS_TXT, encoding="utf-8")
            for page in self.pages:
                if page.published:
                    self.build_page(page)
            self.check_refs()
        finally:
            write_manifest(self.out)
        if self.errors:
            raise BuildError("\n".join(self.errors))
        n = sum(p.published for p in self.pages)
        app = f", shortcuts from {self.app_used}" if self.app_used else ""
        print(f"build: {n} pages, {len(self.rendered)} pictures, {self.version}{app}, into {self.out}")


def main():
    ap = argparse.ArgumentParser(description="Build the docs site into site/.")
    ap.add_argument("--out", type=Path, default=ROOT / "site", help="output directory (default: site/)")
    ap.add_argument("--cli", help="the blockwright-cli to render with (default: $BLOCKWRIGHT_CLI, "
                    "blockwright-cli-dev, blockwright-cli)")
    ap.add_argument("--app", help="the Blockwright app whose --list-actions makes the shortcuts page (default: "
                    "$BLOCKWRIGHT_APP, the app beside the CLI, blockwright-dev, blockwright)")
    ap.add_argument("--forge-url", default=FORGE, help=f"the forge's address in every forge and download link "
                    f"(default: {FORGE})")
    ap.add_argument("--mirror-url", help="the site's other address, named in a line of every page's footer "
                    "(default: none, and no line)")
    args = ap.parse_args()
    try:
        forge = site_url("--forge-url", args.forge_url)
        mirror = site_url("--mirror-url", args.mirror_url) if args.mirror_url is not None else None
        cli = find_cli(args.cli)
        Builder(args.out.resolve(), cli, find_app(args.app, cli), forge, mirror).build()
    except BuildError as e:
        sys.exit(f"build: {e}")


if __name__ == "__main__":
    main()
