# 6. An .ans image path outside the repo is refused.

@scenario
def ans_outside(s):
    """An .ans image outside the repo fails and writes nothing beside --out."""
    esc = s.base / "esc"
    esc.mkdir()
    shutil.copyfile(s.repo / "samples" / "01-what-ansi-art-is" / "cells.ans", esc / "outside.ans")
    s.probe("![outside](../../esc/outside.ans)")
    out = s.base / "esc-out" / "site"
    s.failed("--out", out, says="outside the repo")
    check(sorted(p.name for p in (s.base / "esc-out").iterdir()) == ["site"], "wrote beside --out")


# 7. Markers in fenced code stay as written.

@scenario
def marker_in_fence(s):
    """A generated or list marker inside a fenced block is shown, not replaced."""
    s.probe("```\n<!-- generated: cli-help -->\n```\n\n~~~\n<!-- list: manual -->\n~~~")
    s.passed()
    page = (s.repo / "site" / "manual" / "99-probe.html").read_text(encoding="utf-8")
    check("&lt;!-- generated: cli-help --&gt;" in page, "the generated marker was replaced")
    check("&lt;!-- list: manual --&gt;" in page, "the list marker was replaced")
    check("Usage:" not in page, "the help went into the code block")


@scenario
def marker_outside_fence(s):
    """A marker after a closed fence is still replaced."""
    s.probe("```\ncode\n```\n\n<!-- generated: cli-help -->")
    s.passed()
    page = (s.repo / "site" / "manual" / "99-probe.html").read_text(encoding="utf-8")
    check("Usage: blockwright-cli" in page, "the marker after the fence wasn't replaced")


def markers_replaced(s, body):
    """Both markers in body, which Markdown doesn't treat as code, are replaced,
    and neither is left in the page as an invisible comment."""
    s.probe(body)
    s.passed()
    page = s.page()
    check("<!-- generated" not in page and "<!-- list" not in page, "a marker was left as an HTML comment")
    check("Usage: blockwright-cli" in page, "the cli-help marker wasn't replaced")
    check("Probe</a></li>" in page, "the list marker wasn't replaced")


@scenario
def marker_unclosed_fence(s):
    """Markers after a fence that is never closed (so not code) are replaced."""
    markers_replaced(s, "```\ncode\n\n<!-- generated: cli-help -->\n\n<!-- list: manual -->")


@scenario
def marker_indented_fence(s):
    """Markers between fences indented two spaces (so not code) are replaced."""
    markers_replaced(s, "  ```\n<!-- generated: cli-help -->\n  ```\n\n  ~~~\n<!-- list: manual -->\n  ~~~")


@scenario
def marker_longer_close(s):
    """Markers after a closing fence longer than its opening (so not closed) are replaced."""
    markers_replaced(s, "````\n<!-- generated: cli-help -->\n`````\n\n<!-- list: manual -->")


@scenario
def marker_indented_code(s):
    """Markers in a four-space indented code block are shown as code."""
    s.probe("Code:\n\n    <!-- generated: cli-help -->\n    <!-- list: manual -->")
    s.passed()
    page = s.page()
    check("&lt;!-- generated: cli-help --&gt;" in page, "the generated marker isn't shown")
    check("&lt;!-- list: manual --&gt;" in page, "the list marker isn't shown")
    check("Usage:" not in page, "the help went into the code block")


@scenario
def marker_inline(s):
    """A marker inside a paragraph, which can't be replaced, fails the build."""
    s.probe("Some text <!-- generated: cli-help --> and more.")
    s.failed(says="marker was left as a comment")


COLUMN_0 = "at the start of a line of its own (not indented, not in a list item or blockquote)"


@scenario
def marker_indented(s):
    """A marker indented two spaces fails the build, and the message names the column-0 rule."""
    s.probe("  <!-- generated: cli-help -->")
    s.failed(says=COLUMN_0)


@scenario
def marker_in_list_item(s):
    """A marker in a list item's continuation fails the build, and the message names the column-0 rule."""
    s.probe("1. step\n\n   <!-- list: manual -->")
    s.failed(says=COLUMN_0)


MISSPELLED = ["<!--list: manual-->", "<!-- list: Manual -->", "<!-- List: manual -->",
              "<!-- generated: cli_help -->", "<!-- list:  manual -->", "<!-- list: tutorial -->",
              "<!-- generated: help -->"]


@scenario
def marker_misspelled(s):
    """A misspelled marker in column 0 fails the build, and the message names the
    marker it found and the three it accepts, not the column-0 rule."""
    for body in MISSPELLED:
        s.probe(body)
        try:
            s.failed(says=f"{body} is not a marker the build knows")
            for m in ["<!-- generated: cli-help -->", "<!-- list: tutorials -->", "<!-- list: manual -->"]:
                check(m in s.out, f"{m} not named in: {s.out.strip()[-300:]}")
            check(COLUMN_0 not in s.out, f"column-0 hint given: {s.out.strip()[-300:]}")
        except Fail as e:
            raise Fail(f"{body}: {e}")


# 8. --out an existing file.

@scenario
def out_is_file(s):
    """--out naming a file is a build: error, not a traceback, and the file is kept."""
    f = s.base / "f"
    f.write_text("keep me")
    s.failed("--out", f, says="not a directory")
    check(f.read_text() == "keep me", "the file changed")


# 9. scripts/deploy: local or remote, as rsync decides, and nowhere else.

@scenario
def deploy_local(s):
    """A local destination gets its missing parents made and the site copied, and ssh
    isn't run: a plain path, ./a:b (the colon comes after a slash) and an absolute
    path holding a colon."""
    for dest, root in [(s.base / "web" / "docs", s.base / "web" / "docs"),
                       ("./a:b", s.repo / "a:b"),
                       (s.base / "abs:colon" / "www", s.base / "abs:colon" / "www")]:
        s.deployed(dest)
        s.local()
        s.holds_site(root)


@scenario
def deploy_remote_host(s):
    """host:nested/www goes over ssh to the path as written, relative to the login
    directory, and the missing parent is made there."""
    s.deployed(f"{FAKE_HOST}:nested/www")
    s.remote(None, "nested/www")
    s.holds_site(s.home / "nested" / "www")


@scenario
def deploy_remote_user(s):
    """user@host:nested/www logs in as user, to the path as written, making the missing parent."""
    s.deployed(f"someone@{FAKE_HOST}:nested/www")
    s.remote("someone", "nested/www")
    s.holds_site(s.home / "nested" / "www")


@scenario
def deploy_remote_empty(s):
    """host: and user@host: are refused before ssh runs: never the remote root, and
    never --delete into the login directory."""
    for dest in (f"{FAKE_HOST}:", f"someone@{FAKE_HOST}:"):
        code = s.deploy(dest)
        check(code == 1, f"{dest}: expected exit 1, got {code}: {s.out.strip()[-300:]}")
        check("names no remote directory" in s.out, f"{dest}: no reason given: {s.out.strip()[-300:]}")
        check(not s.calls, f"{dest}: ssh was run: {s.calls}")
        check(not any(s.home.iterdir()), f"{dest}: something was copied")
        s.no_host_dir()


@scenario
def deploy_manifest(s):
    """The manifest is neither copied nor deleted, locally or remotely, and a stale page is deleted."""
    theirs = "the web root's own\n"
    local = s.base / "web"
    for root in (local, s.base / "remote-home" / "www"):
        (root / "old").mkdir(parents=True)
        (root / "old" / "stale.html").write_text("stale\n")
        (root / MANIFEST).write_text(theirs)
    s.deployed(local)
    s.local()
    s.holds_site(local, extra=[MANIFEST])
    check((local / MANIFEST).read_text() == theirs, "the local manifest was overwritten")
    s.deployed(f"{FAKE_HOST}:www")
    s.remote(None, "www")
    www = s.home / "www"
    s.holds_site(www, extra=[MANIFEST])
    check((www / MANIFEST).read_text() == theirs, "the remote manifest was overwritten")


def main():
    ap = argparse.ArgumentParser(description="Check scripts/build and scripts/deploy against scratch copies of the repo.")
    ap.add_argument("--build", type=Path, help="build script to test instead of scripts/build")
    ap.add_argument("--deploy", type=Path, help="deploy script to test instead of scripts/deploy")
    ap.add_argument("scenario", nargs="*", help=f"scenarios to run (default: all): {', '.join(SCENARIOS)}")
    args = ap.parse_args()
    names = args.scenario or list(SCENARIOS)
    unknown = [n for n in names if n not in SCENARIOS]
    if unknown:
        sys.exit(f"test-build: no scenario {', '.join(unknown)}")
    build = args.build.resolve() if args.build else None
    deploy = args.deploy.resolve() if args.deploy else None
    failed = 0
    for name in names:
        with tempfile.TemporaryDirectory(prefix="bw-docs-test-") as base:
            try:
                SCENARIOS[name](Scratch(base, build, deploy))
                print(f"ok    {name}")
            except Fail as e:
                failed += 1
                print(f"FAIL  {name}: {e}")
    print(f"{len(names) - failed} passed, {failed} failed")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
