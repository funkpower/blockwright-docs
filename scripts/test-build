# 7. Markers in fenced code stay as written.

@scenario
def marker_in_fence(s):
    """A generated or list marker inside a fenced block is shown, not replaced."""
    s.probe("```\n<!-- generated: cli-help -->\n```\n\n~~~\n<!-- list: manual -->\n~~~")
    s.passed()
    page = (s.repo / "site" / "manual" / "99-probe.html").read_text(encoding="utf-8")
    check("&lt;!-- generated: cli-help --&gt;" in page, "the generated marker was replaced")
    check("&lt;!-- list: manual --&gt;" in page, "the list marker was replaced")
    check("Usage:" not in page, "the help went into the code block")


@scenario
def marker_outside_fence(s):
    """A marker after a closed fence is still replaced."""
    s.probe("```\ncode\n```\n\n<!-- generated: cli-help -->")
    s.passed()
    page = (s.repo / "site" / "manual" / "99-probe.html").read_text(encoding="utf-8")
    check("Usage: blockwright-cli" in page, "the marker after the fence wasn't replaced")


def markers_replaced(s, body):
    """Both markers in body, which Markdown doesn't treat as code, are replaced,
    and neither is left in the page as an invisible comment."""
    s.probe(body)
    s.passed()
    page = s.page()
    check("<!-- generated" not in page and "<!-- list" not in page, "a marker was left as an HTML comment")
    check("Usage: blockwright-cli" in page, "the cli-help marker wasn't replaced")
    check("Probe</a></li>" in page, "the list marker wasn't replaced")


@scenario
def marker_unclosed_fence(s):
    """Markers after a fence that is never closed (so not code) are replaced."""
    markers_replaced(s, "```\ncode\n\n<!-- generated: cli-help -->\n\n<!-- list: manual -->")


@scenario
def marker_indented_fence(s):
    """Markers between fences indented two spaces (so not code) are replaced."""
    markers_replaced(s, "  ```\n<!-- generated: cli-help -->\n  ```\n\n  ~~~\n<!-- list: manual -->\n  ~~~")


@scenario
def marker_longer_close(s):
    """Markers after a closing fence longer than its opening (so not closed) are replaced."""
    markers_replaced(s, "````\n<!-- generated: cli-help -->\n`````\n\n<!-- list: manual -->")


@scenario
def marker_indented_code(s):
    """Markers in a four-space indented code block are shown as code."""
    s.probe("Code:\n\n    <!-- generated: cli-help -->\n    <!-- list: manual -->")
    s.passed()
    page = s.page()
    check("&lt;!-- generated: cli-help --&gt;" in page, "the generated marker isn't shown")
    check("&lt;!-- list: manual --&gt;" in page, "the list marker isn't shown")
    check("Usage:" not in page, "the help went into the code block")


@scenario
def marker_inline(s):
    """A marker inside a paragraph, which can't be replaced, fails the build."""
    s.probe("Some text <!-- generated: cli-help --> and more.")
    s.failed(says="marker was left as a comment")


COLUMN_0 = "at the start of a line of its own (not indented, not in a list item or blockquote)"


@scenario
def marker_indented(s):
    """A marker indented two spaces fails the build, and the message names the column-0 rule."""
    s.probe("  <!-- generated: cli-help -->")
    s.failed(says=COLUMN_0)


@scenario
def marker_in_list_item(s):
    """A marker in a list item's continuation fails the build, and the message names the column-0 rule."""
    s.probe("1. step\n\n   <!-- list: manual -->")
    s.failed(says=COLUMN_0)


MISSPELLED = ["<!--list: manual-->", "<!-- list: Manual -->", "<!-- List: manual -->",
              "<!-- generated: cli_help -->", "<!-- list:  manual -->", "<!-- list: tutorial -->",
              "<!-- generated: help -->", "<!-- generated: shortcut -->",
              "<!-- generated: check-list -->"]


@scenario
def marker_misspelled(s):
    """A misspelled marker in column 0 fails the build, and the message names the
    marker it found and the five it accepts, not the column-0 rule."""
    for body in MISSPELLED:
        s.probe(body)
        try:
            s.failed(says=f"{body} is not a marker the build knows")
            for m in ["<!-- generated: cli-help -->", "<!-- generated: shortcuts -->", "<!-- generated: checklist -->",
                      "<!-- list: tutorials -->", "<!-- list: manual -->"]:
                check(m in s.out, f"{m} not named in: {s.out.strip()[-300:]}")
            check(COLUMN_0 not in s.out, f"column-0 hint given: {s.out.strip()[-300:]}")
        except Fail as e:
            raise Fail(f"{body}: {e}")


# 8. --out an existing file.

@scenario
def out_is_file(s):
    """--out naming a file is a build: error, not a traceback, and the file is kept."""
    f = s.base / "f"
    f.write_text("keep me")
    s.failed("--out", f, says="not a directory")
    check(f.read_text() == "keep me", "the file changed")


# 9. The site menu on every page.

class MenuParser(html.parser.HTMLParser):
    """Reads a built page: the site menus (<nav class="side">) it carries, each
    as a list of entries, every aria-current on the page, and the page lists
    (an <ol> in <main>) an index page shows."""

    def __init__(self):
        super().__init__()
        self.menus = []      # one list of entries per menu
        self.current = []    # (tag, href) of every element with aria-current
        self.lists = []      # each <ol> in <main>: [(href or None, text)]
        self.stack = []
        self.entry = None
        self.in_main = 0
        self.in_menu = 0
        self.parts = []      # class of each .part div in the menu

    def handle_starttag(self, tag, attrs):
        a = dict(attrs)
        cls = (a.get("class") or "").split()
        if a.get("aria-current"):
            self.current.append((tag, a.get("href"), a["aria-current"], bool(self.in_menu)))
        if tag == "nav" and "side" in cls:
            self.in_menu += 1
            self.menus.append([])
        elif tag == "main":
            self.in_main += 1
        if self.in_menu:
            if tag == "div" and "part" in cls:
                self.parts.append(cls)
            if tag == "a":
                kind = "home" if "home" in cls else "section" if "part-name" in cls else "page"
                self.entry = {"kind": kind, "href": a.get("href"), "text": "",
                              "current": a.get("aria-current")}
            elif tag == "li" and "soon" in cls:
                self.entry = {"kind": "soon", "href": None, "text": "", "current": None}
        elif self.in_main:
            if tag == "ol":
                self.lists.append([])
            elif tag == "li" and self.lists:
                self.entry = {"href": None, "text": "", "skip": 0}
            elif tag == "a" and self.entry is not None:
                self.entry["href"] = a.get("href")
            elif tag == "span" and self.entry is not None:
                self.entry["skip"] += 1  # "(not written yet)"
        self.stack.append(tag)

    def handle_endtag(self, tag):
        while self.stack and self.stack.pop() != tag:
            pass
        if self.in_menu:
            if self.entry and ((tag == "a" and self.entry["kind"] != "soon") or (tag == "li" and self.entry["kind"] == "soon")):
                self.entry["text"] = self.entry["text"].strip()
                self.menus[-1].append(self.entry)
                self.entry = None
            if tag == "nav":
                self.in_menu -= 1
        elif self.in_main:
            if tag == "span" and self.entry is not None:
                self.entry["skip"] -= 1
            elif tag == "li" and self.entry is not None:
                self.lists[-1].append((self.entry["href"], self.entry["text"].strip()))
                self.entry = None
            elif tag == "main":
                self.in_main -= 1

    def handle_data(self, data):
        if self.entry is not None and not self.entry.get("skip"):
            self.entry["text"] += data


def read_site(site):
    """{path from site: MenuParser} for every page in a built site."""
    pages = {}
    for f in sorted(site.rglob("*.html")):
        mp = MenuParser()
        mp.feed(f.read_text(encoding="utf-8"))
        pages[f.relative_to(site).as_posix()] = mp
    return pages


def resolve(page, href):
    """href on page (both relative to the site) as a path from the site root."""
    return os.path.normpath(os.path.join(os.path.dirname(page), href)).replace(os.sep, "/")


def menu_site(s):
    """The repo plus a published page and a stub, built; returns read_site()."""
    s.probe("Probe text.")
    s.write("manual/98-stub.md", "Title: A stub page\n\n# A stub page\n")
    s.passed()
    return read_site(s.repo / "site")


@scenario
def menu_on_every_page(s):
    """Every built page carries the site menu exactly once, and its first entry
    is the home link."""
    pages = menu_site(s)
    check(len(pages) > 3, f"only {len(pages)} pages built")
    for name, mp in pages.items():
        check(len(mp.menus) == 1, f"{name}: {len(mp.menus)} site menus")
        check(mp.menus[0] and mp.menus[0][0]["kind"] == "home", f"{name}: the menu doesn't start with the home link")
        check(resolve(name, mp.menus[0][0]["href"]) == "index.html", f"{name}: the home link isn't index.html")


@scenario
def menu_lists_every_page(s):
    """Every page in the site but the standalone release checklist is linked from
    every page's menu (the checklist from none), a section's pages are listed in
    the order its index lists them, and a stub is shown unlinked and dimmed, as
    in the index."""
    pages = menu_site(s)
    check(CHECKLIST + ".html" in pages, "the release checklist wasn't built")
    built = set(pages) - {CHECKLIST + ".html"}
    indexes = {"tutorials": pages["tutorials/index.html"], "manual": pages["manual/index.html"]}
    for name, mp in pages.items():
        check(len(mp.menus) == 1, f"{name}: {len(mp.menus)} site menus")
        menu = mp.menus[0]
        linked = {resolve(name, e["href"]) for e in menu if e["href"]}
        missing = sorted(built - linked)
        check(not missing, f"{name}: the menu doesn't link {', '.join(missing[:5])}")
        extra = sorted(linked - built)
        check(not extra, f"{name}: the menu links pages that weren't built: {', '.join(extra[:5])}")
        sections = [i for i, e in enumerate(menu) if e["kind"] == "section"]
        check([resolve(name, menu[i]["href"]) for i in sections] == ["tutorials/index.html", "manual/index.html"],
              f"{name}: the menu's sections aren't Tutorials then Manual")
        for (section, index), start, end in zip(indexes.items(), sections, sections[1:] + [len(menu)]):
            got = [(resolve(name, e["href"]) if e["href"] else None, e["text"]) for e in menu[start + 1:end]]
            want = [(resolve(f"{section}/index.html", h) if h else None, t) for h, t in index.lists[0]]
            check(got == want, f"{name}: the {section} menu isn't the index's list:\n  {got}\n  {want}")
        soon = [e for e in menu if e["kind"] == "soon"]
        check(any(e["text"] == "A stub page" for e in soon), f"{name}: the stub isn't in the menu as not written yet")
        check(any(e["text"] == "Probe" and e["href"] for e in menu), f"{name}: the new page isn't linked")


@scenario
def menu_marks_current(s):
    """On every page aria-current="page" is set exactly once, in the menu, on the
    link to the page itself, and the page's section (none on the home page or
    the Docs page) is the one marked "here"; on the standalone release checklist,
    which the menu doesn't list, nothing is marked."""
    pages = menu_site(s)
    check(CHECKLIST + ".html" in pages, "the release checklist wasn't built")
    for name, mp in pages.items():
        if name == CHECKLIST + ".html":
            check(not mp.current and not any("here" in c for c in mp.parts),
                  f"{name}: marked in the menu: {mp.current}, {mp.parts}")
            continue
        check(len(mp.current) == 1, f"{name}: aria-current set {len(mp.current)} times")
        tag, href, value, in_menu = mp.current[0]
        check(tag == "a" and value == "page" and in_menu, f"{name}: aria-current is {value!r} on <{tag}> "
              f"{'in' if in_menu else 'outside'} the menu")
        check(resolve(name, href) == name, f"{name}: aria-current marks {href}, not this page")
        here = [i for i, c in enumerate(mp.parts) if "here" in c]
        section = name.split("/")[0] if "/" in name else None
        want = [["tutorials", "manual"].index(section)] if section in ("tutorials", "manual") else []
        check(here == want, f"{name}: sections marked here: {here}, expected {want}")


# 13. --forge-url, --mirror-url and links out of the site.

FORGE = "https://git.pumpin.online"
RELEASE = FORGE + "/funkpower/blockwright/releases/tag/v0.1.0"
CC = "https://creativecommons.org/licenses/by-sa/4.0/"
GPL = "https://www.gnu.org/licenses/gpl-3.0.html"


def absolute_links(site):
    """{page: [every http or https href and src on it]} for every page in site."""
    found = {}
    for f in sorted(site.rglob("*.html")):
        text = f.read_text(encoding="utf-8")
        found[f.relative_to(site).as_posix()] = [html.unescape(u) for u in
                                                  re.findall(r'(?:href|src)="((?:https?:)?//[^"]*)"', text)]
    return found


@scenario
def forge_url_default(s):
    """Without --forge-url the forge links stay as the pages write them: the
    home page's downloads and the probe's link go to git.pumpin.online, and
    every link out of the site is the forge's or a licence's."""
    s.probe(f"[The release]({RELEASE}) and [the forge]({FORGE}).")
    s.passed()
    links = absolute_links(s.repo / "site")
    check(RELEASE in links["manual/99-probe.html"] and FORGE in links["manual/99-probe.html"],
          f"the probe's forge links changed: {links['manual/99-probe.html']}")
    downloads = [u for u in links["index.html"] if "/releases/download/" in u]
    check(len(downloads) >= 5 and all(u.startswith(FORGE + "/funkpower/blockwright/releases/download/")
                                      for u in downloads), f"the home page's downloads: {downloads}")
    for page, urls in links.items():
        for u in urls:
            check(u == FORGE or u.startswith(FORGE + "/") or u in (CC, GPL), f"{page}: a link out of the site to {u}")


@scenario
def forge_url_moved(s):
    """--forge-url puts its address in place of the forge's in every link on
    every page, a trailing slash dropped, a query-free path and port kept; no
    page names git.pumpin.online any more, and the licence link is left alone."""
    other = "http://forge.example.test:8080/mirror"
    s.probe(f"[The release]({RELEASE}), [the forge]({FORGE}) and [not the forge](https://git.pumpin.online.example.test/x).")
    s.failed("--forge-url", other + "/", says="git.pumpin.online.example.test/x: a link out of the site")
    s.probe(f"[The release]({RELEASE}) and [the forge]({FORGE}).")
    s.passed("--forge-url", other + "/")
    links = absolute_links(s.repo / "site")
    check(other + "/funkpower/blockwright/releases/tag/v0.1.0" in links["manual/99-probe.html"]
          and other in links["manual/99-probe.html"], f"the probe's links: {links['manual/99-probe.html']}")
    downloads = [u for u in links["index.html"] if "/releases/download/" in u]
    check(len(downloads) >= 5 and all(u.startswith(other + "/funkpower/blockwright/releases/download/")
                                      for u in downloads), f"the home page's downloads: {downloads}")
    for f in sorted((s.repo / "site").rglob("*.html")):
        check("git.pumpin.online" not in f.read_text(encoding="utf-8"),
              f"{f.relative_to(s.repo / 'site')} still names git.pumpin.online")
    for page, urls in links.items():
        check(CC in urls, f"{page}: no licence link")
        for u in urls:
            check(u.startswith(other) or u in (CC, GPL), f"{page}: a link out of the site to {u}")


@scenario
def forge_url_refused(s):
    """--forge-url and --mirror-url that aren't an http or https address with a
    host are refused before anything is built."""
    for bad in ["ftp://forge.example.test", "http://", "forge.example.test", "https://forge.example.test/?a=1",
                "https://forge.example.test/#top", "https://forge example.test", "https://forge.example.test:99999",
                "https://forge.example.test:0", "https://user@forge.example.test", ""]:
        for flag in ["--forge-url", "--mirror-url"]:
            s.failed(flag, bad, says=f"{flag}: {bad!r} isn't an http:// or https:// address")
            check(not (s.repo / "site").exists(), f"{flag} {bad!r}: site/ was built")


@scenario
def mirror_url(s):
    """Without --mirror-url no page names another address; with it every page's
    footer carries exactly one line naming it, linked, and a page may link to
    it."""
    s.passed()
    for f in sorted((s.repo / "site").rglob("*.html")):
        check("Also at" not in f.read_text(encoding="utf-8"), f"{f.name}: an Also at line without --mirror-url")
    mirror = "http://blockwright.test/"
    s.probe(f"[The other address]({mirror}manual/14-cli.html).")
    s.failed(says="blockwright.test/manual/14-cli.html: a link out of the site")
    for other in ["http://blockwright.test.example.org/", "http://blockwright.test@example.org/x"]:
        s.probe(f"[Not the mirror]({other}).")
        s.failed("--mirror-url", "http://blockwright.test", says=f"{other}: a link out of the site")
    s.probe(f"[The other address]({mirror}manual/14-cli.html).")
    s.passed("--mirror-url", mirror)
    line = f'Also at <a href="{mirror}">{mirror}</a>'
    for f in sorted((s.repo / "site").rglob("*.html")):
        text = f.read_text(encoding="utf-8")
        footer = text[text.find("<footer>"):text.find("</footer>")]
        check(text.count("Also at") == 1 and line in footer,
              f"{f.relative_to(s.repo / 'site')}: not one Also at line in the footer")


@scenario
def template_links(s):
    """The template's links go through the same pass as a page's: a forge link
    in the footer moves with --forge-url, and a link out of the site there
    fails the build."""
    page = s.repo / "theme" / "page.html"
    text = page.read_text(encoding="utf-8")
    page.write_text(text.replace("</footer>", f' <a href="{FORGE}/funkpower/blockwright">Source</a></footer>'),
                    encoding="utf-8")
    s.passed("--forge-url", "http://forge.example.test")
    home = s.page("index.html")
    check('<a href="http://forge.example.test/funkpower/blockwright">Source</a></footer>' in home,
          "the footer's forge link didn't move")
    page.write_text(text.replace("</footer>", ' <a href="https://example.org/">Elsewhere</a></footer>'),
                    encoding="utf-8")
    s.failed(says="https://example.org/: a link out of the site")


@scenario
def external_link_refused(s):
    """A link or an image out of the site to anything but the forge, the mirror
    and the licences fails the build, naming the page and the address, with or
    without the scheme, quoted either way or not at all, in any case; mailto:
    and the licence link pass, and an address in code, in <pre> text or in a
    comment is no link: neither checked nor moved by --forge-url."""
    for body in ["[elsewhere](https://example.org/page)", "[elsewhere](http://example.org/)",
                 "[elsewhere](//example.org/)", "![a picture](https://example.org/x.png)",
                 '<a href="https://example.com/">raw</a>', "<a href='https://example.com/'>single quotes</a>",
                 '<a HREF = "https://example.com/">upper case</a>', "<a href=https://example.com/>unquoted</a>",
                 f'<img src="{FORGE}/a.png" srcset="{FORGE}/a.png 1x, https://example.com/a.png 2x" alt="">',
                 '<video poster="https://example.com/p.png"></video>',
                 '<div style="background: url(\'https://example.com/b.png\')">styled</div>']:
        s.probe(body)
        s.failed(says="manual/99-probe.md: ")
        check("a link out of the site" in s.out, f"{body}: {s.out.strip()[-300:]}")
    s.probe(f"[Write](mailto:someone@example.org) and [the licence]({CC}).\n\n"
            '`<a href="https://example.org/">` in code\n\n'
            '    <img src="https://example.org/x.png">\n\n'
            '<!-- <a href="https://example.org/">a comment</a> -->\n\n'
            f'<pre>href="https://example.org/" and {FORGE}/x</pre>')
    s.passed("--forge-url", "http://forge.example.test")
    page = s.page()
    s.probe(f'<img src="{FORGE}/a.png" srcset="{FORGE}/a.png 1x, {FORGE}/b.png 2x" alt=""> '
            f'[a query]({FORGE}?tab=repositories) [a fragment]({FORGE}#projects)')
    s.passed("--forge-url", "http://forge.example.test")
    moved = s.page()
    check('srcset="http://forge.example.test/a.png 1x, http://forge.example.test/b.png 2x"' in moved,
          "a srcset's forge addresses weren't moved")
    check('href="http://forge.example.test?tab=repositories"' in moved
          and 'href="http://forge.example.test#projects"' in moved, "the forge with a query or fragment wasn't moved")
    check(f"{FORGE}/x</pre>" in page, "the forge's address in <pre> text changed")
    check("http://forge.example.test" not in page, "text that isn't a link was rewritten as one")


# 14. The home page, the Docs page, release placeholders and pending links.

@scenario
def menu_docs(s):
    """The Docs page is built from docs/index.md with the old index's lists, and
    every page's menu has Home then Docs before the sections; on the home page
    and the Docs page no section is marked here."""
    pages = menu_site(s)
    check("docs/index.html" in pages, "docs/index.html wasn't built")
    lists = pages["docs/index.html"].lists
    check(len(lists) == 2, f"the Docs page has {len(lists)} page lists")
    check({resolve("docs/index.html", h) for h, _ in lists[0] if h} ==
          {resolve("tutorials/index.html", h) for h, _ in pages["tutorials/index.html"].lists[0] if h},
          "the Docs page's first list isn't the tutorials")
    for name, mp in pages.items():
        menu = mp.menus[0]
        top = [resolve(name, e["href"]) for e in menu[1:3]]
        check(top == ["index.html", "docs/index.html"] and [e["text"] for e in menu[1:3]] == ["Home", "Docs"],
              f"{name}: the menu's top links are {top}")
        check(menu[0]["current"] is None, f"{name}: the brand link carries aria-current")
    for name in ("index.html", "docs/index.html"):
        check(not any("here" in c for c in pages[name].parts), f"{name}: a section is marked here")
    home = s.page("index.html")
    check('<body class="landing">' in home, "the home page's body isn't class landing")
    for name in ("docs/index.html", "tutorials/index.html", "manual/99-probe.html"):
        check("<body>" in s.page(name), f"{name}: the body has a class")


@scenario
def release_placeholders(s):
    """{{name}} in a page is filled from release.json before Markdown, in code
    and in links alike, and follows --forge-url; an unknown name fails, naming
    the page and the valid ones; a release.json that is missing or malformed
    fails the build."""
    rel = s.repo / "release.json"
    data = json.loads(rel.read_text(encoding="utf-8"))
    version = data["version"]
    key, asset = next(iter(data["assets"].items()))
    asset = asset.replace("{version}", version)
    s.probe(f"Version {{{{version}}}}.\n\n    curl -LO {{{{download}}}}/{{{{{key}}}}}\n\n"
            f"[the file]({{{{download}}}}/{{{{{key}}}}}) [the release]({{{{release}}}}) [the code]({{{{repo}}}})")
    s.passed()
    page = s.page()
    repo = f"{FORGE}/{data['repo']}"
    check(f"Version {version}." in page, "{{version}} wasn't filled")
    check(f"curl -LO {repo}/releases/download/v{version}/{asset}" in page, "placeholders in code weren't filled")
    check(f'href="{repo}/releases/download/v{version}/{asset}"' in page, "the download link")
    check(f'href="{repo}/releases/tag/v{version}"' in page and f'href="{repo}"' in page, "the release and repo links")
    check("{{" not in page, "a placeholder was left")
    s.passed("--forge-url", "http://forge.example.test")
    page = s.page()
    other = f"http://forge.example.test/{data['repo']}"
    check(f"curl -LO {other}/releases/download/v{version}/{asset}" in page
          and f'href="{other}/releases/download/v{version}/{asset}"' in page, "placeholders didn't follow --forge-url")
    check(f"Blockwright {version}" in s.page("index.html"), "the home page doesn't name the version")
    s.probe("{{nothing}}")
    s.failed(says="manual/99-probe.md: {{nothing}} isn't a release placeholder; they are {{version}}")
    s.probe("Nothing to fill.")
    for bad, says in [("{", "release.json: "), ("[]", "release.json: not a JSON object"),
                      ('{"version": "1", "repo": "a/b", "assets": {"x": "y"}}', "version '1' isn't a version"),
                      ('{"version": "0.2.0", "repo": "ab", "assets": {"x": "y"}}', "repo 'ab' isn't owner/name"),
                      ('{"version": "0.2.0", "repo": "a/b", "assets": {}}', "assets isn't an object"),
                      ('{"version": "0.2.0", "repo": "a/b", "assets": {"Bad": "y"}}', "asset key 'Bad'"),
                      ('{"version": "0.2.0", "repo": "a/b", "assets": {"version": "y"}}', "asset key 'version'"),
                      ('{"version": "0.2.0", "repo": "a/b", "assets": {"x": "../y"}}', "asset x: '../y' isn't a file name")]:
        rel.write_text(bad, encoding="utf-8")
        s.failed(says=says)
    rel.unlink()
    s.failed(says="release.json: ")


@scenario
def release_bump(s):
    """A new version in release.json is the only change a release needs: the home
    page's version and every download link name it."""
    rel = s.repo / "release.json"
    data = json.loads(rel.read_text(encoding="utf-8"))
    data["version"] = "9.8.7"
    rel.write_text(json.dumps(data), encoding="utf-8")
    s.passed()
    home = s.page("index.html")
    downloads = re.findall(r'href="([^"]*/releases/download/[^"]*)"', home)
    check(len(downloads) >= 5 and all("/releases/download/v9.8.7/" in u for u in downloads),
          f"the downloads: {downloads}")
    check("Blockwright 9.8.7" in home and "0.1.1" not in home, "the home page still names the old version")


@scenario
def pending_link(s):
    """A link marked {.pending} to a stub shows its text as not written yet,
    unlinked; once the page is published it is a plain link; one to no page
    fails the build."""
    s.write("manual/98-stub.md", "Title: A stub page\n\n# A stub page\n")
    s.probe("See [the stub](98-stub.md){.pending} and [the other](98-stub.md#x){.pending}.")
    s.passed()
    page = s.page()
    check('<span class="soon">the stub <span>(not written yet)</span></span>' in page, "the stub link isn't marked")
    check("98-stub.html" not in page.split("<main", 1)[1].split("</main>", 1)[0], "the stub is linked in the text")
    check('class="pending"' not in page, "the pending class was left")
    s.write("manual/98-stub.md", "Title: A stub page\nChecked: Blockwright 0.1.0 (test)\n\n# A stub page\n\n"
            "## A heading {#x}\n")
    s.passed()
    page = s.page()
    check('<a href="98-stub.html">the stub</a>' in page and '<a href="98-stub.html#x">the other</a>' in page,
          "the published page isn't linked")
    s.probe("See [nothing](97-none.md){.pending}.")
    s.failed(says="manual/99-probe.md: pending link to 97-none.md: no such page")


# 10. scripts/deploy: local or remote, as rsync decides, and nowhere else.

@scenario
def deploy_local(s):
    """A local destination gets its missing parents made and the site copied, and ssh
    isn't run: a plain path, ./a:b (the colon comes after a slash) and an absolute
    path holding a colon."""
    for dest, root in [(s.base / "web" / "docs", s.base / "web" / "docs"),
                       ("./a:b", s.repo / "a:b"),
                       (s.base / "abs:colon" / "www", s.base / "abs:colon" / "www")]:
        s.deployed(dest)
        s.local()
        s.holds_site(root)


@scenario
def deploy_remote_host(s):
    """host:nested/www goes over ssh to the path as written, relative to the login
    directory, and the missing parent is made there."""
    s.deployed(f"{FAKE_HOST}:nested/www")
    s.remote(None, "nested/www")
    s.holds_site(s.home / "nested" / "www")


@scenario
def deploy_remote_user(s):
    """user@host:nested/www logs in as user, to the path as written, making the missing parent."""
    s.deployed(f"someone@{FAKE_HOST}:nested/www")
    s.remote("someone", "nested/www")
    s.holds_site(s.home / "nested" / "www")


@scenario
def deploy_remote_empty(s):
    """host: and user@host: are refused before ssh runs: never the remote root, and
    never --delete into the login directory."""
    for dest in (f"{FAKE_HOST}:", f"someone@{FAKE_HOST}:"):
        code = s.deploy(dest)
        check(code == 1, f"{dest}: expected exit 1, got {code}: {s.out.strip()[-300:]}")
        check("names no remote directory" in s.out, f"{dest}: no reason given: {s.out.strip()[-300:]}")
        check(not s.calls, f"{dest}: ssh was run: {s.calls}")
        check(not any(s.home.iterdir()), f"{dest}: something was copied")
        s.no_host_dir()


@scenario
def deploy_manifest(s):
    """The manifest is neither copied nor deleted, locally or remotely, and a stale page is deleted."""
    theirs = "the web root's own\n"
    local = s.base / "web"
    for root in (local, s.base / "remote-home" / "www"):
        (root / "old").mkdir(parents=True)
        (root / "old" / "stale.html").write_text("stale\n")
        (root / MANIFEST).write_text(theirs)
    s.deployed(local)
    s.local()
    s.holds_site(local, extra=[MANIFEST])
    check((local / MANIFEST).read_text() == theirs, "the local manifest was overwritten")
    s.deployed(f"{FAKE_HOST}:www")
    s.remote(None, "www")
    www = s.home / "www"
    s.holds_site(www, extra=[MANIFEST])
    check((www / MANIFEST).read_text() == theirs, "the remote manifest was overwritten")


# 11. <!-- generated: shortcuts --> runs the app's --list-actions.

@scenario
def shortcuts_renders(s):
    """The marker becomes a table per menu holding every action the real app
    lists, with its keys, and names the app's Qt; the published page has them too."""
    actions = s.real_actions()
    page = s.shortcuts()
    check("generated: shortcuts" not in page, "the marker was left in the page")
    for menu in dict.fromkeys(a["menu"] for a in actions):
        check(f">{menu.replace('>', '&gt;')}</h3>" in page, f"no heading for {menu}")
    rows = page.count("<tr><td>")
    check(rows == len(actions), f"{rows} rows for {len(actions)} actions")
    check('<h3 id="keys-edit">Edit</h3>' in page, "no Edit heading with its id")
    check("<tr><td>Undo</td><td><kbd>Ctrl</kbd>+<kbd>Z</kbd>" in page, "Undo isn't Ctrl+Z")
    check("<em>(standard)</em>" in page, "no key marked standard")
    check("Offered only in IRC and UTF-8 documents." in page, "the glyph sets don't say where they're offered")
    qt = s.run_real_app("--version").splitlines()[1].strip()
    check(f"starts with on {qt}.</p>" in page, f"the page doesn't name {qt}")
    check("shortcuts from Blockwright" in s.out and qt in s.out, f"the summary doesn't name the app: {s.out.strip()}")
    check('id="keys-edit"' in s.page("manual/15-shortcuts.html"), "the Shortcuts page has no Edit table")


@scenario
def shortcuts_exact(s):
    """A stand-in --list-actions renders exactly: menus in first-seen order, keys
    as <kbd>, hints after shortcuts, the tooltip's name and keys dropped, where an
    action is offered, and everything escaped."""
    page = s.shortcuts("--cli", s.test_cli(), "--app", s.app())
    check(ACTIONS_HTML in page, f"the tables differ: {page[page.find('<p>These'):][:600]}")
    check("shortcuts from Blockwright 0.1.0 (test), Qt 6.12.0" in s.out, f"summary: {s.out.strip()}")


@scenario
def shortcuts_stable(s):
    """Two builds with the real app give the same page, byte for byte."""
    first = s.shortcuts(), s.page("manual/15-shortcuts.html")
    s.passed()
    check(s.page() == first[0], "the probe page changed between builds")
    check(s.page("manual/15-shortcuts.html") == first[1], "the Shortcuts page changed between builds")


@scenario
def shortcuts_app_missing(s):
    """An app asked for that isn't there fails the build and says which option
    named it; one asked for is never passed over for another."""
    s.probe("<!-- generated: shortcuts -->")
    missing = s.base / "no-such-app"
    s.failed("--app", missing, says=f"--app: {missing} isn't an executable")
    s.failed(says=f"BLOCKWRIGHT_APP: {missing} isn't an executable",
             env=dict(os.environ, BLOCKWRIGHT_APP=str(missing)))
    s.failed("--app", missing, says=f"--app: {missing} isn't an executable",
             env=dict(os.environ, BLOCKWRIGHT_APP=s.real_app()))


@scenario
def shortcuts_no_app(s):
    """With no app beside the CLI or on PATH, a page with the marker fails the
    build and says how to name one; without the marker the build doesn't need one."""
    empty = s.base / "empty-bin"
    empty.mkdir()
    env = {k: v for k, v in os.environ.items() if k != "BLOCKWRIGHT_APP"}
    env["PATH"] = str(empty)
    cli = s.cli("")
    s.failed("--cli", cli, says="needs the Blockwright app", env=env)
    check("pass --app or set BLOCKWRIGHT_APP" in s.out, f"no hint: {s.out.strip()[-300:]}")
    # The page without its marker, so the sections other pages link to stay.
    page = (s.repo / "manual/15-shortcuts.md").read_text()
    check("<!-- generated: shortcuts -->" in page, "15-shortcuts.md has no shortcuts marker")
    s.write("manual/15-shortcuts.md", page.replace("<!-- generated: shortcuts -->", ""))
    s.passed("--cli", cli, env=env)


@scenario
def shortcuts_app_fails(s):
    """An app that fails, or prints no action list, or a --version without a Qt
    line, fails the build with what went wrong, not a traceback."""
    s.probe("<!-- generated: shortcuts -->")
    cli = s.test_cli()
    for app, says in [
        (s.app(script='--list-actions) echo "no display" >&2; exit 3 ;;'), "exited 3: no display"),
        (s.app(listing="Usage: blockwright [file]"), "--list-actions printed no action list"),
        (s.app(listing='[{"menu": "File"}]'), "--list-actions printed no action list"),
        (s.app(listing='{"menu": "File"}'), "--list-actions printed no action list"),
        (s.app(listing="[]"), "--list-actions listed no actions"),
        (s.app(version="blockwright 0.1.0 (test)\n"), "--version names no Qt on its second line"),
    ]:
        try:
            s.failed("--cli", cli, "--app", app, says=says)
        except Fail as e:
            raise Fail(f"{says}: {e}")


@scenario
def shortcuts_beside_cli(s):
    """With no --app, the app installed beside the CLI is the one run (the deploy
    passes only --cli), ahead of any on PATH."""
    app = s.app(name="blockwright-dev")
    cli = app.with_name("blockwright-cli-dev")
    shutil.copyfile(s.test_cli(), cli)
    cli.chmod(0o755)
    env = {k: v for k, v in os.environ.items() if k != "BLOCKWRIGHT_APP"}
    s.probe("<!-- generated: shortcuts -->")
    s.passed("--cli", cli, env=env)
    check(ACTIONS_HTML in s.page(), "the app beside the CLI wasn't the one run")


@scenario
def shortcuts_other_commit(s):
    """An app from another Blockwright commit than the CLI fails the build,
    naming both, whether --app names it or it is found on PATH."""
    s.probe("<!-- generated: shortcuts -->")
    other = "blockwright 0.1.0 (deadbee)"
    cli_version = subprocess.run([s.real_cli(), "--version"], stdin=subprocess.DEVNULL, capture_output=True,
                                 text=True, timeout=REAL_APP_TIMEOUT).stdout.splitlines()[0]
    cli_version = cli_version.replace("blockwright-cli-dev", "blockwright-cli")
    s.failed("--app", s.app(version=other + "\nQt 6.8.2\n"), says=f"is {other} but the CLI is {cli_version}")
    # The CLI has no app beside it, so the build looks on PATH.
    app = s.app(version=other + "\nQt 6.8.2\n", name="blockwright-dev")
    env = {k: v for k, v in os.environ.items() if k != "BLOCKWRIGHT_APP"}
    env["PATH"] = f"{app.parent}{os.pathsep}{env['PATH']}"
    s.failed("--cli", s.cli(""), says=f"{app} is {other} but the CLI is {cli_version}", env=env)


@scenario
def shortcuts_app_hangs(s):
    """An app that doesn't answer in $BW_DOCS_APP_TIMEOUT seconds fails the
    build; a timeout that isn't a number above 0 is refused."""
    s.probe("<!-- generated: shortcuts -->")
    app = s.app(script="--list-actions) exec sleep 30 ;;")
    cli = s.test_cli()
    s.failed("--cli", cli, "--app", app, says=f"{app} --list-actions didn't finish in 1 s",
             env=dict(os.environ, BW_DOCS_APP_TIMEOUT="1"))
    for bad in ["0", "-5", "soon", "nan"]:
        s.failed("--cli", cli, "--app", app, says=f"BW_DOCS_APP_TIMEOUT: {bad!r} isn't a number of seconds",
                 env=dict(os.environ, BW_DOCS_APP_TIMEOUT=bad))


# 12. <!-- generated: checklist --> lists every page's status and Checked: commit,
# on a standalone page that nothing links to.


def cli_commit(s):
    """The commit the real CLI's --version names."""
    line = subprocess.run([s.real_cli(), "--version"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                          timeout=REAL_APP_TIMEOUT).stdout.splitlines()[0]
    return line.rsplit("(", 1)[1].rstrip(")")


def checklist_rows(page):
    """{title: (status, checked, ready)} from the checklist tables on page."""
    rows = {}
    for tr in re.findall(r"<tr><td>(.*?)</td></tr>", page):
        cells = tr.split("</td><td>")
        title = re.sub(r"<[^>]+>", "", cells[0])
        rows[title] = tuple(re.sub(r"<[^>]+>", "", c) for c in cells[1:])
    return rows


@scenario
def checklist_renders(s):
    """The release checklist, at the site root, lists every tutorial and manual
    page, each with the commit its Checked: line names, ready when that is the
    CLI's commit and behind when it isn't; a stub is unlinked and not written.
    No other page links to it: not the home page, an index, a menu or a pager."""
    s.passed()
    page = s.page(CHECKLIST + ".html")
    check("generated: checklist" not in page, "the marker was left in the page")
    rows = checklist_rows(page)
    commit = cli_commit(s)
    want = 0
    for section in ("tutorials", "manual"):
        for src in sorted((s.repo / section).glob("*.md")):
            if src.name == "index.md":
                continue
            want += 1
            text = src.read_text(encoding="utf-8")
            title = re.search(r"^Title: (.+)$", text, re.M) or re.search(r"^# (.+)$", text, re.M)
            title = title.group(1).strip()
            check(title in rows, f"{src.name} ({title}) isn't listed")
            status, checked, ready = rows[title]
            m = re.search(r"^Checked: .*\(([0-9a-f]+)\)$", text, re.M)
            if m:
                check(checked == m.group(1), f"{title}: checked against {checked!r}, the page says {m.group(1)}")
                check(ready == ("ready" if m.group(1) == commit else "behind"), f"{title}: {ready!r} at {commit}")
                href = f"{section}/{src.stem}.html"
                check(f'<a href="{href}">' in page, f"{title} isn't linked")
            else:
                check(checked == "" and ready == "not written", f"{title}: a stub shows {checked!r}, {ready!r}")
                check(f">{title}</a>" not in page, f"the stub {title} is linked")
    check(len(rows) == want, f"{len(rows)} rows for {want} pages")
    check("Release checklist" not in rows, "the checklist lists itself")
    check(not list((s.repo / "site" / "manual").glob("*checklist*")), "a checklist page in manual/")
    check(rows["Installing Blockwright"][0] == "Waits for packages", f"Install's status: {rows['Installing Blockwright']}")
    check(rows["What ANSI art is"][0] == "Written", f"tutorial 01's status: {rows['What ANSI art is']}")
    version = subprocess.run([s.real_cli(), "--version"], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                             timeout=REAL_APP_TIMEOUT).stdout.split()[1]
    check(f"<p>Blockwright {version} ({commit}): " in page, f"the summary doesn't name {version} ({commit})")
    site = s.repo / "site"
    for f in sorted(site.rglob("*.html")):
        name = f.relative_to(site).as_posix()
        text = f.read_text(encoding="utf-8")
        links = [h for h in re.findall(r'href="([^"#]*)', text) if h and resolve(name, h) == CHECKLIST + ".html"]
        check(name == CHECKLIST + ".html" or not links, f"{name} links to the checklist: {links}")
        check(name == CHECKLIST + ".html" or "Release checklist" not in text, f"{name} names the checklist")
    pager = re.search(r'<nav class="pager">.*?</nav>', s.page("manual/16-preferences.html"), re.S)
    check(pager and 'rel="next"' not in pager.group(0), f"manual 16's pager has a next page: {pager and pager.group(0)}")


@scenario
def checklist_stable(s):
    """Two builds give the same checklist, byte for byte."""
    s.passed()
    first = s.page(CHECKLIST + ".html")
    s.passed()
    check(s.page(CHECKLIST + ".html") == first, "the checklist changed between builds")


@scenario
def checklist_behind(s):
    """A page checked against the CLI's commit is ready; checked against an older
    one it is behind, naming that commit, and the summary counts it."""
    commit = cli_commit(s)
    older = "30c37b9" if commit != "30c37b9" else "93be0b4"
    src = s.repo / "manual" / "06-symmetry.md"
    text = src.read_text(encoding="utf-8")
    s.write("manual/06-symmetry.md", re.sub(r"^Checked: .*$", f"Checked: Blockwright 0.1.0 ({commit})", text,
                                            count=1, flags=re.M))
    s.passed()
    page = s.page(CHECKLIST + ".html")
    check(checklist_rows(page)["Mirror mode and symmetry"] == ("Written", commit, "ready"),
          f"at {commit}: {checklist_rows(page)['Mirror mode and symmetry']}")
    ready = int(re.search(r": (\d+) of \d+ pages ready", page).group(1))
    s.write("manual/06-symmetry.md", re.sub(r"^Checked: .*$", f"Checked: Blockwright 0.1.0 ({older})", text,
                                            count=1, flags=re.M))
    s.passed()
    page = s.page(CHECKLIST + ".html")
    check(checklist_rows(page)["Mirror mode and symmetry"] == ("Written", older, "behind"),
          f"at {older}: {checklist_rows(page)['Mirror mode and symmetry']}")
    check(f": {ready - 1} of " in page, "the summary didn't count it as no longer ready")


CHECKLIST_PLAN = """# Plan

| # | Tutorial | Covers | Status |
|---|---|---|---|
| 01 | Alpha one | a | Written, checked against `aaaaaaa` |
| 02 | Beta | b | Waits for `#12` <soon> & more |

| Page | Source | Status |
|---|---|---|
| Gamma | x \\| y | Written for stamps (partly); the rest |
"""
CHECKLIST_HTML = """<p>Blockwright 0.1.0 (1234abc): 1 of 4 pages ready, 2 behind, 1 not written.</p>
<p>A page is ready when it is written and was last checked against <code>1234abc</code>. A page checked against another commit is behind: its steps and options have to be checked again against this one.</p>
<h3 id="checklist-tutorials">Tutorials</h3>
<table class="checklist">
<thead><tr><th>Page</th><th>Status</th><th>Checked against</th><th>Ready</th></tr></thead>
<tbody>
<tr><td><a href="tutorials/01-alpha-one.html">Alpha &amp; one</a></td><td>Written</td><td><code>aaaaaaa</code></td><td>behind</td></tr>
<tr><td>Beta</td><td>Waits for <code>#12</code> &lt;soon&gt; &amp; more</td><td></td><td>not written</td></tr>
</tbody>
</table>
<h3 id="checklist-manual">Manual</h3>
<table class="checklist">
<thead><tr><th>Page</th><th>Status</th><th>Checked against</th><th>Ready</th></tr></thead>
<tbody>
<tr><td><a href="manual/01-gamma.html">Gamma</a></td><td>Written for stamps</td><td><code>1234abcdef0</code></td><td>ready</td></tr>
<tr><td><a href="manual/02-delta.html">Delta</a></td><td></td><td><code>bbbbbbb</code></td><td>behind</td></tr>
</tbody>
</table>"""


def checklist_stand_in(s, commit):
    """The stand-in plan and pages, and a home page that links none of the
    real ones, built with a stand-in CLI at commit; returns the checklist page."""
    for section in ("tutorials", "manual"):
        for src in (s.repo / section).glob("*.md"):
            if src.name != "index.md":
                src.unlink()
    s.write("PLAN.md", CHECKLIST_PLAN)
    s.write("index.md", "Title: Blockwright\n\n# Blockwright\n")
    s.write("tutorials/01-alpha-one.md", "Title: Alpha & one\nChecked: Blockwright 0.1.0 (aaaaaaa)\n\n# Alpha\n")
    s.write("tutorials/02-beta.md", "# Beta\n\nNot written yet.\n")
    s.write("manual/01-gamma.md", "Title: Gamma\nChecked: Blockwright 0.1.0 (1234abcdef0)\n\n# Gamma\n")
    s.write("manual/02-delta.md", "Title: Delta\nChecked: Blockwright 0.1.0 (bbbbbbb)\n\n# Delta\n")
    s.write(CHECKLIST + ".md", "Title: Release checklist\n\n# Release checklist\n\n<!-- generated: checklist -->\n")
    cli = s.cli(f'--version) echo "blockwright-cli 0.1.0 ({commit})"; exit 0 ;;')
    s.passed("--cli", cli)
    return s.page(CHECKLIST + ".html")


@scenario
def checklist_exact(s):
    """With a stand-in CLI and plan, the checklist renders exactly: status cut to
    its leading words and escaped, a table cell holding an escaped pipe, a page
    with no plan row, a stub, and a full commit matching the CLI's short one."""
    page = checklist_stand_in(s, "1234abc")
    check(CHECKLIST_HTML in page, f"the checklist differs: {page[page.find('<p>Blockwright'):][:900]}")


@scenario
def checklist_dirty(s):
    """A CLI built from a changed tree (its commit ends -dirty) is no commit: a
    page checked against the commit it was changed from is behind."""
    checklist_stand_in(s, "1234abc-dirty")
    s.write("manual/01-gamma.md", "Title: Gamma\nChecked: Blockwright 0.1.0 (1234abc)\n\n# Gamma\n")
    s.passed("--cli", s.cli('--version) echo "blockwright-cli 0.1.0 (1234abc-dirty)"; exit 0 ;;'))
    page = s.page(CHECKLIST + ".html")
    rows = checklist_rows(page)
    check(rows["Gamma"] == ("Written for stamps", "1234abc", "behind"), f"Gamma: {rows['Gamma']}")
    check("Blockwright 0.1.0 (1234abc-dirty): 0 of 4 pages ready, 3 behind, 1 not written." in page,
          f"the summary: {page[page.find('<p>Blockwright'):][:120]}")


def main():
    ap = argparse.ArgumentParser(description="Check scripts/build and scripts/deploy against scratch copies of the repo.")
    ap.add_argument("--build", type=Path, help="build script to test instead of scripts/build")
    ap.add_argument("--deploy", type=Path, help="deploy script to test instead of scripts/deploy")
    ap.add_argument("scenario", nargs="*", help=f"scenarios to run (default: all): {', '.join(SCENARIOS)}")
    args = ap.parse_args()
    names = args.scenario or list(SCENARIOS)
    unknown = [n for n in names if n not in SCENARIOS]
    if unknown:
        sys.exit(f"test-build: no scenario {', '.join(unknown)}")
    build = args.build.resolve() if args.build else None
    deploy = args.deploy.resolve() if args.deploy else None
    failed = 0
    for name in names:
        with tempfile.TemporaryDirectory(prefix="bw-docs-test-") as base:
            try:
                SCENARIOS[name](Scratch(base, build, deploy))
                print(f"ok    {name}")
            except Fail as e:
                failed += 1
                print(f"FAIL  {name}: {e}")
    print(f"{len(names) - failed} passed, {failed} failed")
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    main()
