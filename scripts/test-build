#!/usr/bin/env python3
"""Run scripts/build and scripts/deploy against scratch copies of the repo and
check what they do.

    scripts/test-build [--build FILE] [--deploy FILE] [scenario ...]

Each scenario copies the repo (without .git and site/) into a fresh temporary
directory, changes the copy, runs the build or the deploy there and checks the
result. With --build or --deploy, FILE is used as the copy's scripts/build or
scripts/deploy instead, to try another version of the script against the same
scenarios. The deploy scenarios copy a small stand-in site/ and give rsync a
stand-in ssh that logs its arguments and runs the rsync server in a scratch
directory, so no host is contacted. Needs what the build needs: Python-Markdown,
a blockwright-cli and the Blockwright app beside it or on PATH (the shortcuts
page runs its --list-actions); the deploy scenarios need rsync 3.2.3 or later.
Exits 1 if any scenario fails.
"""

import argparse
import html.parser
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import zlib
import struct
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
MANIFEST = ".blockwright-docs-manifest"
SITE = {"index.html": "home\n", "manual/page.html": "page\n", MANIFEST: "index.html\nmanual/page.html\n"}
FAKE_HOST = "fakehost.invalid"
# Stand-in ssh: rsync runs it as `ssh [-l user] host rsync --server ... path`.
# It logs one file per call, drops -l and the host, and runs the command in a
# scratch directory standing in for the remote login directory. It refuses an
# absolute or upward path, so a broken deploy can't reach outside that directory.
FAKE_SSH = """#!/bin/sh
printf '%s\\n' "$@" > "{log}/call.$$"
[ "$1" = -l ] && shift 2
shift
for path; do :; done
case "$path" in
    /*|..|../*|*/..|*/../*) echo "fake-ssh: refusing remote path $path" >&2; exit 12 ;;
esac
cd "{home}" && exec sh -c "$*"
"""
APP_VERSION = "blockwright 0.1.0 (test)\nQt 6.12.0\n\ncredits\n"
# A stand-in --list-actions: a menu that comes back after another, a standard
# key, standard keys some keyboards have (F14, Undo), a hint, Ctrl++, a tool's tooltip that starts with its name and key,
# Qt's tooltip of a menu text with a tab, an action offered only in some
# documents, and text that needs escaping.
ACTIONS = [
    {"id": "newFile", "menu": "File", "text": "New", "shortcuts": ["Ctrl+N"], "standardKey": "New",
     "statusTip": "", "toolTip": "New"},
    {"id": "undo", "menu": "File", "text": "Undo", "shortcuts": ["Ctrl+Z", "F14", "Undo"], "standardKey": "Undo",
     "statusTip": "", "toolTip": "Undo"},
    {"id": "zoomIn", "menu": "View > Zoom", "text": "Zoom <In>", "shortcuts": ["Ctrl+=", "Ctrl++"],
     "statusTip": "", "toolTip": "Zoom <In> (Ctrl+=)\nMakes the cells bigger &\nsharper."},
    {"id": "deleteSelection", "menu": "File", "text": "Delete", "shortcuts": [], "hint": "Del",
     "statusTip": "", "toolTip": "Delete\tDel"},
    {"id": "glyphSet21", "menu": "Glyphs", "text": "Set 21: \u2726", "shortcuts": [], "statusTip": "Sparkles",
     "toolTip": "Set 21", "offeredWhen": "in IRC and UTF-8 documents"},
]
ACTIONS_HTML = """<p>These are the keys Blockwright 0.1.0 (test) starts with on Qt 6.12.0.</p>
<p>Keys marked <em>(standard)</em> are the platform's standard keys for that action: the table gives the ones Qt gives a Linux desktop, and another platform, or another version of Qt, can give the action other keys.</p>
<p><kbd>F14</kbd> and <kbd>Undo</kbd> are keys some keyboards have.</p>
<h3 id="keys-file">File</h3>
<table class="keys">
<thead><tr><th>Action</th><th>Shortcut</th><th>What it does</th></tr></thead>
<tbody>
<tr><td>New</td><td><kbd>Ctrl</kbd>+<kbd>N</kbd> <em>(standard)</em></td><td></td></tr>
<tr><td>Undo</td><td><kbd>Ctrl</kbd>+<kbd>Z</kbd>, <kbd>F14</kbd>, <kbd>Undo</kbd> <em>(standard)</em></td><td></td></tr>
<tr><td>Delete</td><td><kbd>Del</kbd></td><td></td></tr>
</tbody>
</table>
<h3 id="keys-view-zoom">View &gt; Zoom</h3>
<table class="keys">
<thead><tr><th>Action</th><th>Shortcut</th><th>What it does</th></tr></thead>
<tbody>
<tr><td>Zoom &lt;In&gt;</td><td><kbd>Ctrl</kbd>+<kbd>=</kbd>, <kbd>Ctrl</kbd>+<kbd>+</kbd></td><td>Makes the cells bigger &amp; sharper.</td></tr>
</tbody>
</table>
<h3 id="keys-glyphs">Glyphs</h3>
<table class="keys">
<thead><tr><th>Action</th><th>Shortcut</th><th>What it does</th></tr></thead>
<tbody>
<tr><td>Set 21: \u2726</td><td></td><td>Sparkles Offered only in IRC and UTF-8 documents.</td></tr>
</tbody>
</table>"""
# The version a stand-in CLI from Scratch.test_cli() names, which matches a
# stand-in app's APP_VERSION.
TEST_CLI_VERSION = "blockwright-cli 0.1.0 (test)"
# How long the tests give the real app to answer.
REAL_APP_TIMEOUT = 120
PROBE_META = "Title: Probe\nChecked: Blockwright 0.1.0 (test)\n\n# Probe\n\n## A heading\n\n"


# The maintainer's release checklist, built at the site root and linked from no page.
CHECKLIST = "release-checklist"


class Fail(Exception):
    pass


def check(cond, what):
    if not cond:
        raise Fail(what)


class Scratch:
    def __init__(self, base, build, deploy=None):
        self.base = Path(base)
        self.repo = self.base / "docs"
        shutil.copytree(ROOT, self.repo, ignore=shutil.ignore_patterns(".git", "site", "__pycache__"))
        if build:
            shutil.copyfile(build, self.repo / "scripts" / "build")
        if deploy:
            shutil.copyfile(deploy, self.repo / "scripts" / "deploy")

    def write(self, rel, text):
        p = self.repo / rel
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(text, encoding="utf-8")
        return p

    def probe(self, body):
        """A published manual page holding body."""
        self.write("manual/99-probe.md", PROBE_META + body + "\n")

    def build(self, *args, env=None):
        r = subprocess.run([sys.executable, "-I", str(self.repo / "scripts" / "build"), *map(str, args)],
                           cwd=self.repo, capture_output=True, text=True, env=env)
        self.out = r.stdout + r.stderr
        return r.returncode

    def failed(self, *args, says, env=None):
        code = self.build(*args, env=env)
        check(code == 1, f"expected exit 1, got {code}: {self.out.strip()[-300:]}")
        check("Traceback" not in self.out, f"traceback: {self.out.strip()[-300:]}")
        check(says in self.out, f"expected {says!r} in: {self.out.strip()[-300:]}")

    def passed(self, *args, env=None):
        code = self.build(*args, env=env)
        check(code == 0, f"expected exit 0, got {code}: {self.out.strip()[-300:]}")

    def page(self, rel="manual/99-probe.html"):
        f = self.repo / "site" / rel
        check(f.is_file(), f"site/{rel} wasn't built")
        return f.read_text(encoding="utf-8")

    def deploy(self, dest):
        """Run scripts/deploy on the stand-in site with BW_DOCS_DEST=dest and the
        stand-in ssh. Leaves the ssh calls (argument lists) in self.calls and the
        stand-in remote login directory in self.home."""
        for rel, text in SITE.items():
            self.write(f"site/{rel}", text)
        self.home = self.base / "remote-home"
        self.home.mkdir(exist_ok=True)
        log = self.base / "ssh-log"
        shutil.rmtree(log, ignore_errors=True)
        log.mkdir()
        ssh = self.base / "fake-ssh"
        ssh.write_text(FAKE_SSH.format(log=log, home=self.home))
        ssh.chmod(0o755)
        env = dict(os.environ, BW_DOCS_DEST=str(dest), RSYNC_RSH=str(ssh))
        r = subprocess.run(["sh", str(self.repo / "scripts" / "deploy")], cwd=self.repo, env=env,
                           capture_output=True, text=True)
        self.out = r.stdout + r.stderr
        self.calls = [p.read_text().splitlines() for p in sorted(log.iterdir())]
        return r.returncode

    def deployed(self, dest):
        code = self.deploy(dest)
        check(code == 0, f"deploy to {dest}: expected exit 0, got {code}: {self.out.strip()[-300:]}")

    def local(self):
        check(not self.calls, f"ssh was run: {self.calls}")

    def no_host_dir(self):
        check(not any(FAKE_HOST in p.name for p in self.repo.iterdir()), "a local directory named after the host")

    def remote(self, user, path):
        """One ssh call, to FAKE_HOST as user, with the remote path rsync means by path."""
        check(len(self.calls) == 1, f"expected one ssh call, got {self.calls}")
        argv = self.calls[0]
        got_user = argv[1] if argv[:1] == ["-l"] else None
        argv = argv[2:] if got_user else argv
        check(argv[0] == FAKE_HOST, f"ssh to {argv[0]!r}, not {FAKE_HOST}")
        check(got_user == user, f"ssh as {got_user!r}, not {user!r}")
        check(argv[-1] == path, f"remote path {argv[-1]!r}, not {path!r}")
        self.no_host_dir()

    def holds_site(self, root, extra=()):
        """root holds the stand-in site without its manifest, plus the files in extra."""
        check(root.is_dir(), f"no directory {root}")
        got = sorted(p.relative_to(root).as_posix() for p in root.rglob("*") if p.is_file())
        want = sorted([r for r in SITE if r != MANIFEST] + list(extra))
        check(got == want, f"{root} holds {got}, not {want}")
        for rel in want:
            if rel in SITE and rel != MANIFEST:
                check((root / rel).read_text() == SITE[rel], f"{rel} differs")

    def real_cli(self):
        real = shutil.which(os.environ.get("BLOCKWRIGHT_CLI", "")) or shutil.which("blockwright-cli-dev") \
            or shutil.which("blockwright-cli")
        check(real, "no blockwright-cli")
        return real

    def run_cli(self, *args):
        """Runs the real blockwright-cli in the copy; fails the scenario if it fails."""
        r = subprocess.run([self.real_cli(), *map(str, args)], cwd=self.repo, stdin=subprocess.DEVNULL,
                           capture_output=True, text=True)
        check(r.returncode == 0, f"blockwright-cli {' '.join(map(str, args))} exited {r.returncode}: "
                                 f"{(r.stdout + r.stderr).strip()[-300:]}")

    def cli(self, script):
        """A stand-in blockwright-cli: a shell script that runs the real one
        unless script (sh case arms on "$1") handles the call first."""
        real = self.real_cli()
        p = self.base / "fake-cli"
        p.write_text(f'#!/bin/sh\ncase "$1" in\n{script}\nesac\nexec "{real}" "$@"\n')
        p.chmod(0o755)
        return p

    def test_cli(self):
        """A stand-in blockwright-cli that names TEST_CLI_VERSION, the commit a
        stand-in app names, and runs the real one for everything else."""
        return self.cli(f'--version) echo "{TEST_CLI_VERSION}"; exit 0 ;;')

    def real_app(self):
        real = shutil.which(os.environ.get("BLOCKWRIGHT_APP", "")) or shutil.which("blockwright-dev") \
            or shutil.which("blockwright")
        check(real, "no Blockwright app")
        return real

    def run_real_app(self, *args):
        """The real app's stdout for args; fails the scenario if it fails or
        runs past REAL_APP_TIMEOUT."""
        try:
            r = subprocess.run([self.real_app(), *args], stdin=subprocess.DEVNULL, capture_output=True, text=True,
                               env=dict(os.environ, QT_QPA_PLATFORM="offscreen"), timeout=REAL_APP_TIMEOUT)
        except subprocess.TimeoutExpired:
            raise Fail(f"the app's {' '.join(args)} didn't finish in {REAL_APP_TIMEOUT} s")
        check(r.returncode == 0, f"{' '.join(args)} exited {r.returncode}")
        return r.stdout

    def real_actions(self):
        return json.loads(self.run_real_app("--list-actions"))

    def app(self, listing=None, version=APP_VERSION, script="", name="fake-app"):
        """A stand-in Blockwright app in a new directory: --version prints
        version and --list-actions prints listing (a list, as JSON, or a
        string as it is), unless script (sh case arms on "$1") handles the call
        first."""
        n = 1
        while (self.base / f"app-bin-{n}").exists():
            n += 1
        d = self.base / f"app-bin-{n}"
        d.mkdir()
        (d / "version").write_text(version, encoding="utf-8")
        text = listing if isinstance(listing, str) else json.dumps(listing or ACTIONS, ensure_ascii=False)
        (d / "actions.json").write_text(text, encoding="utf-8")
        p = d / name
        p.write_text(f'#!/bin/sh\ncase "$1" in\n{script}\n--version) cat "{d}/version" ;;\n'
                     f'--list-actions) cat "{d}/actions.json" ;;\n*) exit 2 ;;\nesac\n')
        p.chmod(0o755)
        return p

    def shortcuts(self, *args):
        """Builds with the shortcuts marker on the probe page; returns the page."""
        self.probe("<!-- generated: shortcuts -->")
        self.passed(*args)
        return self.page()


def tiny_png():
    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))
    return (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", struct.pack(">IIBBBBB", 1, 1, 8, 2, 0, 0, 0))
            + chunk(b"IDAT", zlib.compress(b"\x00\xff\x00\x00")) + chunk(b"IEND", b""))


SCENARIOS = {}


def scenario(fn):
    SCENARIOS[fn.__name__.replace("_", "-")] = fn
    return fn


@scenario
def baseline(s):
    """The repo as it is builds into site/, twice, with no robots meta and the licence footer."""
    s.passed()
    s.passed()
    page = (s.repo / "site" / "index.html").read_text(encoding="utf-8")
    check('name="robots"' not in page, "a robots meta tag on the home page")
    check("creativecommons.org/licenses/by-sa/4.0/" in page, "no licence in the footer")
    check((s.repo / "site" / MANIFEST).is_file(), "no manifest in site/")


@scenario
def robots_txt(s):
    """The site gets a robots.txt that allows everything, listed in the manifest,
    in site/ and in --out, and no page carries a robots meta tag but the
    standalone release checklist, which carries noindex."""
    allow = "User-agent: *\nAllow: /\n"
    x = s.base / "x"
    for args, out in [((), s.repo / "site"), (("--out", x), x)]:
        s.passed(*args)
        check((out / "robots.txt").is_file(), f"no robots.txt in {out}")
        check((out / "robots.txt").read_text(encoding="utf-8") == allow, f"{out}/robots.txt isn't allow-all")
        listed = (out / MANIFEST).read_text(encoding="utf-8").splitlines()
        check("robots.txt" in listed, f"robots.txt not in {out}/{MANIFEST}")
        check((out / (CHECKLIST + ".html")).is_file(), f"no {CHECKLIST}.html in {out}")
        for f in sorted(out.rglob("*.html")):
            text = f.read_text(encoding="utf-8")
            if f.relative_to(out).as_posix() == CHECKLIST + ".html":
                check(text.count('name="robots"') == 1 and '<meta name="robots" content="noindex">' in text,
                      f"{f.relative_to(out)} doesn't carry exactly one noindex robots meta tag")
            else:
                check('name="robots"' not in text, f"robots meta tag in {f.relative_to(out)}")
    s.passed("--out", x)  # a site holding robots.txt is one the build wrote


# 1. --out never clears a directory the build didn't write.

@scenario
def out_theme(s):
    """--out theme is refused and theme/ is untouched."""
    before = sorted(p.name for p in (s.repo / "theme").iterdir())
    s.failed("--out", "theme", says="inside the repo")
    check(sorted(p.name for p in (s.repo / "theme").iterdir()) == before, "theme/ changed")


@scenario
def out_inside_repo(s):
    """--out anywhere in the repo but site/ is refused and not created."""
    s.failed("--out", "manual/out", says="inside the repo")
    check(not (s.repo / "manual" / "out").exists(), "manual/out was created")


@scenario
def out_holds_repo(s):
    """--out a directory that holds the repo is refused."""
    s.failed("--out", s.base, says="holds the repo")
    check((s.repo / "PLAN.md").is_file(), "the repo was cleared")


@scenario
def out_foreign_dir(s):
    """A directory with a site.css and other-app/ is refused and kept."""
    x = s.base / "x"
    (x / "other-app").mkdir(parents=True)
    (x / "site.css").write_text("")
    (x / "other-app" / "data.txt").write_text("keep me")
    s.failed("--out", x, says="not a site this build wrote")
    check((x / "other-app" / "data.txt").is_file(), "other-app/data.txt is gone")


@scenario
def out_built_then_added(s):
    """A built site with a file added to it later is refused and the file kept."""
    x = s.base / "x"
    s.passed("--out", x)
    s.passed("--out", x)
    (x / "notes.txt").write_text("keep me")
    s.failed("--out", x, says="notes.txt")
    check((x / "notes.txt").is_file(), "notes.txt is gone")


@scenario
def out_empty_dir(s):
    """An existing empty directory is built into."""
    x = s.base / "x"
    x.mkdir()
    s.passed("--out", x)
    check((x / "index.html").is_file(), "no index.html")


@scenario
def out_failed_build_reused(s):
    """A build that failed part way can be rebuilt into the same directory."""
    x = s.base / "x"
    s.probe("[x](14-cli.md#no-such-anchor)")
    s.failed("--out", x, says="no-such-anchor")
    (s.repo / "manual" / "99-probe.md").unlink()
    s.passed("--out", x)


# 2. Linked repo files are copied into the site.

@scenario
def asset_png(s):
    """An image of an existing .png is copied into the site."""
    (s.repo / "img").mkdir()
    (s.repo / "img" / "pic.png").write_bytes(tiny_png())
    s.probe("![a picture](../img/pic.png)")
    s.passed()
    check((s.repo / "site" / "img" / "pic.png").read_bytes() == tiny_png(), "pic.png not copied")


@scenario
def asset_linked_ans(s):
    """A link to an .ans no page draws is copied into the site."""
    s.write("samples/zz/only-linked.ans", "x")
    s.probe("[only-linked.ans](../samples/zz/only-linked.ans)")
    s.passed()
    check((s.repo / "site" / "samples" / "zz" / "only-linked.ans").is_file(), "only-linked.ans not copied")


@scenario
def asset_missing(s):
    """A link to a file that doesn't exist fails the build."""
    s.probe("[gone](../img/gone.png)")
    s.failed(says="gone.png")


@scenario
def asset_outside(s):
    """A link to a file outside the repo fails the build."""
    (s.base / "secret.txt").write_text("x")
    s.probe("[secret](../../secret.txt)")
    s.failed(says="outside the repo")


@scenario
def asset_symlink_outside(s):
    """A link through a symlink in the repo to a file outside it fails the build."""
    (s.base / "secret.txt").write_text("x")
    (s.repo / "samples" / "out").symlink_to(s.base)
    s.probe("[secret](../samples/out/secret.txt)")
    s.failed(says="outside the repo")
    check(not (s.repo / "site" / "samples" / "out").exists(), "the file was copied")


@scenario
def asset_git(s):
    """A link to a file under .git/ fails the build."""
    s.write(".git/config", "[core]\n")
    s.probe("[config](../.git/config)")
    s.failed(says="not a file the site can carry")
    check(not (s.repo / "site" / ".git").exists(), ".git/config was copied")


@scenario
def asset_symlink_git(s):
    """A link through a symlink into .git/ fails the build and copies nothing."""
    s.write(".git/config", "[core]\n")
    (s.repo / "samples" / "gl").mkdir()
    (s.repo / "samples" / "gl" / "g").symlink_to(Path("..", "..", ".git"))
    s.probe("[s](../samples/gl/g/config)")
    s.failed(says="not a file the site can carry")
    check(not (s.repo / "site" / "samples" / "gl").exists(), ".git/config was copied")


@scenario
def ans_symlink_git(s):
    """An .ans image through a symlink into .git/ fails before anything is drawn."""
    (s.repo / ".git").mkdir()
    shutil.copyfile(s.repo / "samples" / "01-what-ansi-art-is" / "cells.ans", s.repo / ".git" / "x.ans")
    (s.repo / "samples" / "gl").mkdir()
    (s.repo / "samples" / "gl" / "g").symlink_to(Path("..", "..", ".git"))
    s.probe("![x](../samples/gl/g/x.ans)")
    s.failed(says="not a file the site can carry")
    check(not (s.repo / "site" / "samples" / "gl").exists(), "the .ans was drawn into the site")


# Links to pages, samples and renders.

@scenario
def link_stub(s):
    """A link to a page that isn't written yet (no Checked:) fails the build."""
    s.write("manual/98-stub.md", "Title: Stub\n\n# Stub\n")
    s.probe("[stub](98-stub.md)")
    s.failed(says="that page isn't written yet")


@scenario
def link_no_page(s):
    """A link to a page that doesn't exist fails the build."""
    s.probe("[none](97-none.md)")
    s.failed(says="no such page")


@scenario
def sample_missing(s):
    """An .ans image that doesn't exist fails the build."""
    s.probe("![x](../samples/nope.ans)")
    s.failed(says="no sample samples/nope.ans")


@scenario
def render_rejected(s):
    """An .ans the CLI refuses to render (an empty file) fails the build."""
    s.write("samples/zz/empty.ans", "")
    s.probe("![x](../samples/zz/empty.ans)")
    s.failed(says="empty file")


@scenario
def render_fails(s):
    """A CLI whose render exits 1 fails the build."""
    cli = s.cli('render) echo "render broke" >&2; exit 1;;')
    s.failed("--cli", cli, says="render broke")


@scenario
def render_no_picture(s):
    """A CLI whose render exits 0 but writes no picture fails the build."""
    cli = s.cli("render) exit 0;;")
    s.failed("--cli", cli, says="the render wrote no picture")


# Projects (.bwp) as pictures, and image kinds the build doesn't know.

# Three layers made with scripts/ansi.py's scene(): sky, then a hill, then a sun.
LAYERED_SCENE = """import sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parents[2] / "scripts"))
from ansi import scene

def sky(c):
    c.fill(0, 0, 15, 3, " ", 7, 1)

def hill(c):
    c.fill(0, 3, 15, 3, " ", 7, 2)
    c.fill(4, 2, 11, 2, "\u2584", 2, 1)

def sun(c):
    c.fill(12, 0, 13, 0, "\u2584", 14, 1)
    c.fill(12, 1, 13, 1, "\u2580", 14, 1)

scene([("sky", sky), ("hill", hill), ("sun", sun)], 16, 4, Path(__file__).with_name("flat.ans"), title="Layers")
"""


def img_tag(page, png):
    """The <img> tag in page that shows png."""
    tag = next((t for t in page.split("<img ")[1:] if f'src="{png}"' in t), None)
    check(tag, f"no <img> of {png}")
    return tag.partition(">")[0]


@scenario
def bwp_render(s):
    """A .bwp image (three layers, from import-scene) is drawn as its composite and linked."""
    scene = s.write("samples/zz/layers.py", LAYERED_SCENE)
    r = subprocess.run([sys.executable, "-I", "-B", str(scene)], stdin=subprocess.DEVNULL, capture_output=True,
                       text=True)
    check(r.returncode == 0, f"the scene failed: {r.stderr.strip()[-300:]}")
    s.run_cli("import-scene", scene, "samples/zz/layers.bwp")
    s.probe('![layers](../samples/zz/layers.bwp "2x")')
    s.passed()
    page = s.page()
    check('<a class="ans" href="../samples/zz/layers.bwp">' in page, "the picture doesn't link to the .bwp")
    check('width="256" height="128"' in img_tag(page, "../samples/zz/layers.bwp-2x.png"), "wrong size")
    site = s.repo / "site" / "samples" / "zz"
    check((site / "layers.bwp").read_bytes() == (s.repo / "samples" / "zz" / "layers.bwp").read_bytes(),
          "the .bwp wasn't copied into the site")
    s.run_cli("render", "--scale", "2", "samples/zz/flat.ans", s.base / "flat.png")
    check((site / "layers.bwp-2x.png").read_bytes() == (s.base / "flat.png").read_bytes(),
          "the composite isn't the scene's flat picture")


@scenario
def scene_title(s):
    """scene() refuses a title import-scene would drop SAUCE for (empty, 36 characters, not CP437) with a
    message, before it lists its layers; a 35-character title imports with SAUCE."""
    for i, title in enumerate(["", "x" * 36, "Sun \u2600"]):
        scene = s.write(f"samples/zz/bad{i}.py", LAYERED_SCENE.replace('title="Layers"', f"title={title!r}"))
        r = subprocess.run([sys.executable, "-I", "-B", str(scene), "--list-layers"], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True)
        said = (r.stdout + r.stderr).strip()[-300:]
        check(r.returncode == 1 and not r.stdout, f"title {title!r}: --list-layers exited {r.returncode}: {said}")
        check("Traceback" not in r.stderr and "1-35 characters" in r.stderr, f"title {title!r}: {said}")
    r = subprocess.run([s.real_cli(), "import-scene", scene, "samples/zz/bad.bwp"], cwd=s.repo,
                       stdin=subprocess.DEVNULL, capture_output=True, text=True)
    said = (r.stdout + r.stderr).strip()[-300:]
    check(r.returncode != 0 and "1-35 characters" in said and "Traceback" not in said, f"import-scene: {said}")
    check(not (s.repo / "samples" / "zz" / "bad.bwp").exists(), "import-scene wrote a project")
    scene = s.write("samples/zz/ok.py", LAYERED_SCENE.replace('title="Layers"', f"title={'y' * 35!r}"))
    s.run_cli("import-scene", scene, "samples/zz/ok.bwp")
    s.run_cli("unpack", "samples/zz/ok.bwp", "samples/zz/ok")
    manifest = json.loads((s.repo / "samples" / "zz" / "ok" / "manifest.json").read_text(encoding="utf-8"))
    check((manifest.get("sauce") or {}).get("title") == "y" * 35, f"no SAUCE title: {manifest.get('sauce')}")


@scenario
def scene_ice_off(s):
    """scene() refuses a layer that leaves the canvas with iCE off, with a message and no traceback, whatever
    it was asked: import-scene would make an iCE-on project whose composite isn't the flat picture."""
    scene = s.write("samples/zz/iceoff.py", LAYERED_SCENE.replace(
        "    c.fill(4, 2, 11, 2,", "    c.ice = False\n    c.fill(4, 2, 11, 2,"))
    for args in (["--list-layers"], ["--layer-ans=sky"], []):
        r = subprocess.run([sys.executable, "-I", "-B", str(scene), *args], stdin=subprocess.DEVNULL,
                           capture_output=True, text=True)
        said = (r.stdout + r.stderr).strip()[-300:]
        check(r.returncode == 1 and not r.stdout, f"{args}: exited {r.returncode}: {said}")
        check("Traceback" not in r.stderr and "hill: leaves the canvas with iCE off" in r.stderr, f"{args}: {said}")
    check(not (s.repo / "samples" / "zz" / "flat.ans").exists(), "the scene wrote its flat picture")
    r = subprocess.run([s.real_cli(), "import-scene", scene, "samples/zz/iceoff.bwp"], cwd=s.repo,
                       stdin=subprocess.DEVNULL, capture_output=True, text=True)
    said = (r.stdout + r.stderr).strip()[-300:]
    check(r.returncode != 0 and "iCE off" in said and "Traceback" not in said, f"import-scene: {said}")
    check(not (s.repo / "samples" / "zz" / "iceoff.bwp").exists(), "import-scene wrote a project")


