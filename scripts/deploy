#!/bin/sh
# Copy site/ to the web root in $BW_TUTORIAL_DEST.
set -eu
: "${BW_TUTORIAL_DEST:?set BW_TUTORIAL_DEST to the web root for /blockwright/}"
cd "$(dirname "$0")/.."
mkdir -p "$BW_TUTORIAL_DEST"
# The share refuses chmod: copy contents and times, not permissions.
rsync -rt --delete --no-perms --omit-dir-times site/ "$BW_TUTORIAL_DEST/"
