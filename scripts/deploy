#!/bin/sh
# Copy site/ to the web root in $BW_DOCS_DEST.
set -eu
: "${BW_DOCS_DEST:?set BW_DOCS_DEST to the web root for /blockwright/}"
cd "$(dirname "$0")/.."
mkdir -p "$BW_DOCS_DEST"
# The share refuses chmod: copy contents and times, not permissions.
# The build manifest stays out of the web root.
rsync -rt --inplace --delete --no-perms --omit-dir-times --exclude=/.blockwright-docs-manifest site/ "$BW_DOCS_DEST/"
